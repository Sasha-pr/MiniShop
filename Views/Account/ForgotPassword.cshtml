@{
    ViewData["Title"] = "Восстановление пароля";
}

<section class="auth-card">
    <h1>Восстановление пароля</h1>
    <p class="muted">Введи email своего аккаунта.</p>

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <label for="email">Email</label>
        <input id="email" name="email" type="email"
               autocomplete="email" required />

        <div asp-validation-summary="All"></div>

        <button class="button button-dark full" type="submit">
            Создать ссылку
        </button>
    </form>

    @if (ViewBag.Message != null)
    {
        <p>@ViewBag.Message</p>
    }

    @if (ViewBag.ResetLink != null)
    {
        <p>
            Учебная ссылка для сброса пароля:
            <a href="@ViewBag.ResetLink">Сбросить пароль</a>
        </p>
    }

    <p><a asp-action="Login">Вернуться ко входу</a></p>
</section>
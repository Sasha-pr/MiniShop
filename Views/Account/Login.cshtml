
@model MiniShop.Models.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="auth-eyebrow">SIMPLESTORE / ЛИЧНЫЙ КАБИНЕТ</p>

        <h1>С возвращением</h1>

        <p class="auth-description">
            Войди в свой аккаунт, чтобы продолжить покупки
            и пользоваться возможностями магазина.
        </p>

        <form asp-action="Login" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-errors"></div>

            <div class="auth-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email"
                       type="email"
                       autocomplete="off"
                       placeholder="name@example.com" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password">Пароль</label>
                <input asp-for="Password"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Введи пароль" />
                <span asp-validation-for="Password"></span>
            </div>

            <label class="auth-remember">
                <input asp-for="RememberMe" />
                <span>Запомнить меня</span>
            </label>

            <button class="button button-dark auth-submit" type="submit">
                Войти в аккаунт
            </button>

            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        </form>

        <div class="auth-extra-link">
            <a asp-controller="Account" asp-action="ForgotPassword">
                Забыли пароль?
            </a>
        </div>

        <div class="auth-divider">
            <span>Новый покупатель?</span>
        </div>

        <p class="auth-switch">
            Ещё нет аккаунта?
            <a asp-action="Register">Зарегистрироваться</a>
        </p>

        <a class="auth-back" asp-controller="Products" asp-action="Index">
            ← Вернуться в магазин
        </a>
    </div>
</section>

<style>
    .auth-page {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 45px 15px 70px;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        padding: 38px;
        background: #fff;
        border: 1px solid #e9eae6;
        border-radius: 20px;
        box-shadow: 0 12px 40px rgba(32, 33, 31, .045);
    }

    .auth-eyebrow {
        color: #8b9a77;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 1.5px;
        margin: 0 0 15px;
    }

    .auth-card h1 {
        color: #20211f;
        font-size: 32px;
        letter-spacing: -1px;
        margin: 0 0 12px;
    }

    .auth-description {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        margin: 0 0 27px;
    }

    .auth-field {
        margin-bottom: 19px;
    }

    .auth-field label {
        display: block;
        color: #333;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .auth-field input {
        width: 100%;
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #e3e5df;
        border-radius: 10px;
        background: #fafbf9;
        color: #20211f;
        font: inherit;
        font-size: 14px;
        outline: none;
        transition: border-color .2s, background .2s;
    }

    .auth-field input:focus {
        border-color: #8b9a77;
        background: #fff;
    }

    .auth-field span.field-validation-error,
    .auth-errors {
        display: block;
        color: #a33b3b;
        font-size: 12px;
        margin-top: 6px;
    }

    .auth-remember {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #666;
        font-size: 13px;
        margin: 4px 0 22px;
    }

    .auth-remember input {
        accent-color: #8b9a77;
        width: 16px;
        height: 16px;
    }

    .auth-submit {
        width: 100%;
        min-height: 49px;
        border: 0;
        cursor: pointer;
    }

    .auth-extra-link {
        text-align: right;
        margin-top: 16px;
        font-size: 13px;
    }

    .auth-extra-link a,
    .auth-switch a {
        color: #71845f;
        font-weight: 650;
        text-decoration: none;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 27px 0 17px;
        color: #999;
        font-size: 12px;
    }

    .auth-divider::before,
    .auth-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #eeeeeb;
    }

    .auth-switch {
        text-align: center;
        color: #777;
        font-size: 13px;
        margin: 0;
    }

    .auth-back {
        display: block;
        text-align: center;
        color: #888;
        font-size: 13px;
        text-decoration: none;
        margin-top: 27px;
    }

    .auth-back:hover {
        color: #20211f;
    }

    @@media (max-width: 500px) {
        .auth-card {
            padding: 27px 21px;
        }

        .auth-card h1 {
            font-size: 28px;
        }
    }
</style>

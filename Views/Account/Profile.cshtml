@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Личный кабинет";
}

<style>
    .profile-page {
        max-width: 1050px;
        margin: 45px auto;
        padding: 0 20px;
    }

    .profile-heading {
        margin-bottom: 30px;
    }

    .profile-heading h1 {
        color: #263c35;
        font-size: 30px;
        font-weight: 800;
    }

    .profile-heading p {
        color: #78827b;
        font-size: 14px;
    }

    .profile-user {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 25px;
        margin-bottom: 25px;
        background: white;
        border: 1px solid #e5eae5;
        border-radius: 16px;
    }

    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: #dce8df;
        color: #263c35;
        font-size: 27px;
        font-weight: 800;
    }

    .profile-user h2 {
        margin: 0 0 6px;
        color: #263c35;
        font-size: 19px;
    }

    .profile-user p {
        margin: 0;
        color: #78827b;
        font-size: 13px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .profile-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px;
        background: white;
        border: 1px solid #e5eae5;
        border-radius: 14px;
        color: #26332d;
        text-decoration: none;
        transition: .2s;
    }

    .profile-card:hover {
        transform: translateY(-3px);
        border-color: #9aaf9f;
        box-shadow: 0 8px 20px rgba(38,60,53,.06);
    }

    .profile-card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #edf3ee;
        font-size: 22px;
    }

    .profile-card h3 {
        margin: 0 0 5px;
        color: #263c35;
        font-size: 14px;
    }

    .profile-card p {
        margin: 0;
        color: #78827b;
        font-size: 12px;
    }

    @@media(max-width: 650px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }

        .profile-heading h1 {
            font-size: 25px;
        }
    }
</style>

<div class="profile-page">

    <div class="profile-heading">
        <h1>Личный кабинет</h1>
        <p>Здесь собрана вся информация о твоих покупках и аккаунте.</p>
    </div>

    <div class="profile-user">
        <div class="profile-avatar">
            @(Model.Email?.Substring(0, 1).ToUpper() ?? "U")
        </div>

        <div>
            <h2>@Model.UserName</h2>
            <p>@Model.Email</p>
        </div>
    </div>

    <div class="profile-grid">

        <a asp-controller="MyOrders" asp-action="Index" class="profile-card">
            <div class="profile-card-icon">▣</div>
            <div>
                <h3>Мои заказы</h3>
                <p>История покупок и статусы заказов</p>
            </div>
        </a>

        <a asp-controller="Bookmarks" asp-action="Index" class="profile-card">
            <div class="profile-card-icon">♡</div>
            <div>
                <h3>Избранное</h3>
                <p>Сохранённые товары</p>
            </div>
        </a>

        <a asp-controller="Notifications" asp-action="Index" class="profile-card">
            <div class="profile-card-icon">♧</div>
            <div>
                <h3>Уведомления</h3>
                <p>Важные сообщения магазина</p>
            </div>
        </a>

        <a asp-controller="ReturnRequests" asp-action="Index" class="profile-card">
            <div class="profile-card-icon">↩</div>
            <div>
                <h3>Мои возвраты</h3>
                <p>Заявки на возврат товаров</p>
            </div>
        </a>

        <a asp-controller="Chat" asp-action="MyRequests" class="profile-card">
            <div class="profile-card-icon">☏</div>
            <div>
                <h3>Поддержка</h3>
                <p>Обращения и переписка с магазином</p>
            </div>
        </a>

        <a asp-controller="Waitlist" asp-action="Index" class="profile-card">
            <div class="profile-card-icon">◷</div>
            <div>
                <h3>Лист ожидания</h3>
                <p>Товары, которые тебя интересуют</p>
            </div>
        </a>

    </div>
</div>

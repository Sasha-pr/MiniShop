
@{
    ViewData["Title"] = "Сброс пароля";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="auth-eyebrow">SIMPLESTORE / БЕЗОПАСНОСТЬ</p>

        <h1>Новый пароль</h1>

        <p class="auth-description">
            Придумай новый пароль для своего аккаунта,
            чтобы снова пользоваться магазином.
        </p>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="userId"
                   value="@ViewBag.UserId" />

            <input type="hidden"
                   name="token"
                   value="@ViewBag.Token" />

            <div asp-validation-summary="All" class="auth-errors"></div>

            <div class="auth-field">
                <label for="password">Новый пароль</label>
                <input id="password"
                       name="password"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Введи новый пароль"
                       required />
            </div>

            <div class="auth-field">
                <label for="confirmPassword">Повтори новый пароль</label>
                <input id="confirmPassword"
                       name="confirmPassword"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Повтори новый пароль"
                       required />
            </div>

            <button class="button button-dark auth-submit" type="submit">
                Сохранить новый пароль
            </button>
        </form>

        <a class="auth-back" asp-controller="Account" asp-action="Login">
            ← Вернуться ко входу
        </a>
    </div>
</section>

<style>
    .auth-page {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 45px 15px 70px;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        padding: 38px;
        background: #fff;
        border: 1px solid #e9eae6;
        border-radius: 20px;
        box-shadow: 0 12px 40px rgba(32, 33, 31, .045);
    }

    .auth-eyebrow {
        color: #8b9a77;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 1.5px;
        margin: 0 0 15px;
    }

    .auth-card h1 {
        color: #20211f;
        font-size: 32px;
        letter-spacing: -1px;
        margin: 0 0 12px;
    }

    .auth-description {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        margin: 0 0 27px;
    }

    .auth-field {
        margin-bottom: 19px;
    }

    .auth-field label {
        display: block;
        color: #333;
        font-size: 13px;
        font-weight: 650;
        margin-bottom: 8px;
    }

    .auth-field input {
        width: 100%;
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #e3e5df;
        border-radius: 10px;
        background: #fafbf9;
        color: #20211f;
        font: inherit;
        font-size: 14px;
        outline: none;
    }

    .auth-field input:focus {
        border-color: #8b9a77;
        background: #fff;
    }

    .auth-submit {
        width: 100%;
        min-height: 49px;
        border: 0;
        cursor: pointer;
        margin-top: 5px;
    }

    .auth-errors {
        color: #a33b3b;
        font-size: 12px;
        margin: 8px 0;
    }

    .auth-back {
        display: block;
        text-align: center;
        color: #888;
        font-size: 13px;
        text-decoration: none;
        margin-top: 27px;
    }

    .auth-back:hover {
        color: #20211f;
    }

    @@media (max-width: 500px) {
        .auth-card {
            padding: 27px 21px;
        }

        .auth-card h1 {
            font-size: 28px;
        }
    }
</style>

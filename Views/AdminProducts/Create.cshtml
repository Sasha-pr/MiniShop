
@model MiniShop.Models.Product

@{
    ViewData["Title"] = "Добавление товара";
}

<style>
    .admin-product-page {
        max-width: 700px;
        margin: 40px auto 80px;
    }

    .admin-product-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 30px;
    }

    .admin-product-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .admin-product-field label {
        font-weight: 600;
        font-size: 14px;
    }

    .admin-product-field input,
    .admin-product-field textarea {
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 9px;
        font: inherit;
        width: 100%;
        box-sizing: border-box;
    }

    .admin-product-field textarea {
        min-height: 110px;
        resize: vertical;
    }

    .admin-product-error {
        color: #b42318;
        font-size: 13px;
    }

    .admin-product-button {
        background: #20211f;
        color: white;
        border: 0;
        padding: 15px;
        border-radius: 9px;
        font: inherit;
        cursor: pointer;
    }

    .admin-product-back {
        display: inline-block;
        margin-top: 20px;
        color: #555;
    }
</style>

<div class="admin-product-page">

    <p class="eyebrow">SIMPLESTORE / АДМИНИСТРАТОР</p>

    <h1>Добавление товара</h1>

    <p class="muted">
        Заполните информацию о новом товаре.
    </p>

    <form asp-controller="AdminProducts"
          asp-action="Create"
          method="post"
          class="admin-product-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="admin-product-error"></div>

        <div class="admin-product-field">
            <label asp-for="Name">Название товара</label>
            <input asp-for="Name" required maxlength="200"
                   placeholder="Керамическая кружка" />
        </div>

        <div class="admin-product-field">
            <label asp-for="Description">Описание</label>
            <textarea asp-for="Description"
                      placeholder="Описание товара"></textarea>
        </div>

        <div class="admin-product-field">
            <label asp-for="Price">Цена, ₽</label>
            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   min="0.01"
                   required />
        </div>

        <div class="admin-product-field">
            <label asp-for="Category">Категория</label>
            <input asp-for="Category"
                   placeholder="Посуда" />
        </div>

        <div class="admin-product-field">
            <label asp-for="ImageUrl">Ссылка на изображение</label>
            <input asp-for="ImageUrl"
                   placeholder="/images/mug.jpg" />
        </div>

        <div class="admin-product-field">
            <label asp-for="StockQuantity">
                Количество на складе
            </label>
            <input asp-for="StockQuantity"
                   type="number"
                   min="0"
                   required />
        </div>

        <button type="submit" class="admin-product-button">
            Сохранить товар
        </button>

    </form>

    <a asp-controller="AdminProducts"
       asp-action="Index"
       class="admin-product-back">
        ← Вернуться к товарам
    </a>

</div>
ы
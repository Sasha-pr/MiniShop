
@model MiniShop.Models.Product

@{
    ViewData["Title"] = "Редактирование товара";
}

<style>
    .edit-product-page {
        max-width: 700px;
        margin: 40px auto 80px;
    }

    .edit-product-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 30px;
    }

    .edit-product-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .edit-product-field label {
        font-weight: 600;
        font-size: 14px;
    }

    .edit-product-field input,
    .edit-product-field textarea {
        width: 100%;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 9px;
        font: inherit;
        box-sizing: border-box;
    }

    .edit-product-field textarea {
        min-height: 110px;
        resize: vertical;
    }

    .edit-product-preview {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #eee;
    }

    .edit-product-actions {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .edit-product-save {
        background: #20211f;
        color: white;
        border: none;
        padding: 14px 22px;
        border-radius: 9px;
        font: inherit;
        cursor: pointer;
    }

    .edit-product-cancel {
        color: #777;
        text-decoration: none;
    }

    .edit-product-error {
        color: #b42318;
        font-size: 13px;
    }
</style>

<div class="edit-product-page">

    <p class="eyebrow">
        SIMPLESTORE / АДМИНИСТРАТОР
    </p>

    <h1>Редактирование товара</h1>

    <p class="muted">
        Измените информацию о товаре №@Model.Id
    </p>

    <form asp-controller="AdminProducts"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          class="edit-product-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All"
             class="edit-product-error"></div>

        <div class="edit-product-field">
            <label asp-for="Name">
                Название товара
            </label>

            <input asp-for="Name"
                   required
                   maxlength="200" />
        </div>

        <div class="edit-product-field">
            <label asp-for="Description">
                Описание
            </label>

            <textarea asp-for="Description"></textarea>
        </div>

        <div class="edit-product-field">
            <label asp-for="Price">
                Цена, ₽
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   min="0.01"
                   required />
        </div>

        <div class="edit-product-field">
            <label asp-for="Category">
                Категория
            </label>

            <input asp-for="Category" />
        </div>

        <div class="edit-product-field">
            <label asp-for="ImageUrl">
                Ссылка на изображение
            </label>

            <input asp-for="ImageUrl"
                   id="product-image-url" />

            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img id="product-image-preview"
                     class="edit-product-preview"
                     src="@Model.ImageUrl"
                     alt="Изображение товара" />
            }
            else
            {
                <img id="product-image-preview"
                     class="edit-product-preview"
                     alt="Изображение товара"
                     style="display:none" />
            }
        </div>

        <div class="edit-product-field">
            <label asp-for="StockQuantity">
                Количество на складе
            </label>

            <input asp-for="StockQuantity"
                   type="number"
                   min="0"
                   required />
        </div>

        <div class="edit-product-actions">

            <button type="submit"
                    class="edit-product-save">
                Сохранить изменения
            </button>

            <a class="edit-product-cancel"
               asp-controller="AdminProducts"
               asp-action="Index">
                Отмена
            </a>

        </div>

    </form>

</div>

<script>
    const imageInput = document.getElementById(
        'product-image-url'
    );

    const imagePreview = document.getElementById(
        'product-image-preview'
    );

    imageInput.addEventListener('input', function () {
        const imageUrl = this.value.trim();

        if (imageUrl) {
            imagePreview.src = imageUrl;
            imagePreview.style.display = 'block';
        }
        else {
            imagePreview.removeAttribute('src');
            imagePreview.style.display = 'none';
        }
    });
</script>

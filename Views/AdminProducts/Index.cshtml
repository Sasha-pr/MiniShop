
@model List<MiniShop.Models.Product>

@{
    ViewData["Title"] = "Управление товарами";

    var categories = ViewBag.Categories as List<string> ?? new List<string>();

    string search = ViewBag.Search as string ?? "";
    string selectedCategory = ViewBag.SelectedCategory as string ?? "";
    string selectedStock = ViewBag.SelectedStock as string ?? "";
    string selectedSort = ViewBag.SelectedSort as string ?? "";
}

<style>
    .admin-products {
        padding: 30px 0 75px;
        color: #20211f;
    }

    .admin-products * {
        box-sizing: border-box;
    }

    .admin-products .hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        padding: 35px;
        margin-bottom: 30px;
        background: #f5f6f2;
        border-radius: 17px;
    }

    .admin-products .hero h1 {
        font-size: clamp(30px, 4vw, 42px);
        margin: 10px 0;
    }

    .admin-products .hero p {
        margin-bottom: 0;
    }

    .admin-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 35px;
    }

    .admin-stat {
        padding: 20px;
        background: #fff;
        border: 1px solid #e8e9e5;
        border-radius: 13px;
    }

    .admin-stat span {
        display: block;
        color: #777a74;
        font-size: 12px;
        margin-bottom: 10px;
    }

    .admin-stat strong {
        display: block;
        font-size: 27px;
    }

    .admin-products-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .admin-products-toolbar h2 {
        font-size: 23px;
        margin: 5px 0;
    }

    .admin-products-filter {
        display: grid;
        grid-template-columns: minmax(180px, 1.5fr) repeat(3, minmax(140px, 1fr)) auto;
        gap: 12px;
        padding: 18px;
        margin-bottom: 22px;
        background: #fafaf8;
        border: 1px solid #e8e9e5;
        border-radius: 13px;
    }

    .admin-products-filter input,
    .admin-products-filter select {
        width: 100%;
        min-width: 0;
        height: 44px;
        padding: 0 12px;
        border: 1px solid #dedfd9;
        border-radius: 8px;
        background: #fff;
        color: #20211f;
        font: inherit;
        font-size: 13px;
    }

    .admin-products-filter input:focus,
    .admin-products-filter select:focus {
        outline: none;
        border-color: #8b9a77;
        box-shadow: 0 0 0 3px rgba(139, 154, 119, .12);
    }

    .admin-products-filter-actions {
        display: flex;
        gap: 8px;
    }

    .admin-products-filter-actions .button {
        height: 44px;
        white-space: nowrap;
    }

    .admin-products-alert {
        padding: 14px 17px;
        margin-bottom: 18px;
        border-radius: 10px;
        font-size: 13px;
    }

    .admin-products-alert.success {
        background: #edf6ed;
        color: #32643b;
        border: 1px solid #d9ead9;
    }

    .admin-products-alert.error {
        background: #fff0f0;
        color: #a12c2c;
        border: 1px solid #f1dada;
    }

    .admin-products-table-wrap {
        overflow-x: auto;
        background: #fff;
        border: 1px solid #e8e9e5;
        border-radius: 14px;
    }

    .admin-products-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .admin-products-table th {
        padding: 16px;
        background: #f8f9f6;
        color: #777a74;
        font-size: 11px;
        font-weight: 700;
        text-align: left;
        letter-spacing: .5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .admin-products-table td {
        padding: 15px 16px;
        border-top: 1px solid #eceee8;
        font-size: 13px;
        vertical-align: middle;
    }

    .admin-products-table tbody tr:hover {
        background: #fcfcfa;
    }

    .admin-product-info {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 220px;
    }

    .admin-product-image {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 9px;
        background: #f5f6f2;
        border: 1px solid #e8e9e5;
    }

    .admin-product-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 9px;
        background: #f5f6f2;
        color: #8b9a77;
        font-size: 11px;
    }

    .admin-product-name {
        display: block;
        max-width: 240px;
        font-weight: 650;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .admin-product-id {
        display: block;
        margin-top: 4px;
        color: #92958e;
        font-size: 11px;
    }

    .admin-product-price {
        font-weight: 700;
        white-space: nowrap;
    }

    .admin-stock {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 20px;
        background: #edf6ed;
        color: #397448;
        font-size: 11px;
        font-weight: 650;
        white-space: nowrap;
    }

    .admin-stock.low {
        background: #fff5e5;
        color: #9a6c2d;
    }

    .admin-stock.empty {
        background: #fff0ef;
        color: #a6534b;
    }

    .admin-product-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .admin-product-actions .button {
        padding: 9px 12px;
        font-size: 11px;
    }

    .admin-product-actions form {
        margin: 0;
    }

    .admin-product-actions .button-danger {
        background: #fff0ef;
        color: #a6534b;
    }

    .admin-products-result {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 13px;
        color: #777a74;
        font-size: 12px;
    }

    .admin-products-empty {
        padding: 55px 20px;
        text-align: center;
    }

    .admin-products-empty h3 {
        margin: 0 0 10px;
    }

    .admin-products-empty p {
        color: #777a74;
        font-size: 13px;
        margin-bottom: 20px;
    }

    @@media (max-width: 950px) {
        .admin-products-filter {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .admin-products-filter-actions {
            grid-column: 1 / -1;
        }

        .admin-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .admin-products .hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 24px 20px;
        }

        .admin-products-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-products-toolbar > a {
            width: 100%;
        }

        .admin-products-filter {
            grid-template-columns: 1fr;
        }

        .admin-products-filter-actions {
            grid-column: auto;
        }

        .admin-products-filter-actions .button {
            flex: 1;
        }

        .admin-stat {
            padding: 15px;
        }

        .admin-stat strong {
            font-size: 23px;
        }
    }
</style>

<div class="admin-page admin-products">

    <div class="hero">
        <div>
            <p class="eyebrow">SIMPLESTORE / АДМИНИСТРИРОВАНИЕ</p>
            <h1>Товары магазина</h1>
            <p class="muted">
                Управляйте каталогом, ценами, категориями и складскими остатками.
            </p>
        </div>

        <a asp-controller="AdminProducts"
           asp-action="Create"
           class="button button-dark">
            + Добавить товар
        </a>
    </div>

    <div class="admin-stat-grid">
        <div class="admin-stat">
            <span>Всего товаров</span>
            <strong>@ViewBag.TotalProducts</strong>
        </div>

        <div class="admin-stat">
            <span>Есть в наличии</span>
            <strong>@ViewBag.AvailableProducts</strong>
        </div>

        <div class="admin-stat">
            <span>Маленький остаток</span>
            <strong>@ViewBag.LowStockProducts</strong>
        </div>

        <div class="admin-stat">
            <span>Нет в наличии</span>
            <strong>@ViewBag.EmptyProducts</strong>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="admin-products-alert success" role="status">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-products-alert error" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="admin-products-toolbar">
        <div>
            <p class="eyebrow">КАТАЛОГ</p>
            <h2>Управление товарами</h2>
        </div>
    </div>

    <form asp-controller="AdminProducts"
          asp-action="Index"
          method="get"
          class="admin-products-filter">

        <input type="text"
               name="search"
               value="@search"
               placeholder="Поиск по названию или описанию" />

        <select name="category">
            <option value="">Все категории</option>

            @foreach (var item in categories)
            {
                if (selectedCategory == item)
                {
                    <option value="@item" selected>@item</option>
                }
                else
                {
                    <option value="@item">@item</option>
                }
            }
        </select>

        <select name="stock">
            <option value="">Любой остаток</option>
            <option value="available" selected="@(selectedStock == "available")">
                Есть в наличии
            </option>
            <option value="low" selected="@(selectedStock == "low")">
                Осталось меньше 3
            </option>
            <option value="empty" selected="@(selectedStock == "empty")">
                Нет в наличии
            </option>
        </select>

        <select name="sort">
            <option value="">Сначала новые</option>
            <option value="name" selected="@(selectedSort == "name")">
                По названию А–Я
            </option>
            <option value="name_desc" selected="@(selectedSort == "name_desc")">
                По названию Я–А
            </option>
            <option value="price" selected="@(selectedSort == "price")">
                Сначала дешевле
            </option>
            <option value="price_desc" selected="@(selectedSort == "price_desc")">
                Сначала дороже
            </option>
            <option value="stock" selected="@(selectedSort == "stock")">
                По остатку: меньше
            </option>
            <option value="stock_desc" selected="@(selectedSort == "stock_desc")">
                По остатку: больше
            </option>
        </select>

        <div class="admin-products-filter-actions">
            <button type="submit" class="button button-dark">
                Найти
            </button>

            <a asp-controller="AdminProducts"
               asp-action="Index"
               class="button button-light">
                Сбросить
            </a>
        </div>
    </form>

    <div class="admin-products-result">
        <span>Найдено товаров: @Model.Count</span>
        <span>Всего категорий: @categories.Count</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="admin-products-table-wrap">
            <div class="admin-products-empty">
                <h3>Товары не найдены</h3>
                <p>
                    Попробуйте изменить параметры поиска
                    или добавьте новый товар.
                </p>

                <a asp-controller="AdminProducts"
                   asp-action="Create"
                   class="button button-dark">
                    Добавить товар
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="admin-products-table-wrap">
            <table class="admin-products-table">
                <thead>
                    <tr>
                        <th>Товар</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Остаток</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="admin-product-info">

                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             alt="@product.Name"
                                             class="admin-product-image"
                                             loading="lazy"
                                             onerror="this.style.display='none'" />
                                    }
                                    else
                                    {
                                        <div class="admin-product-placeholder">
                                            Нет фото
                                        </div>
                                    }

                                    <div>
                                        <span class="admin-product-name">
                                            @product.Name
                                        </span>
                                        <span class="admin-product-id">
                                            Товар №@product.Id
                                        </span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(product.Category)
                                    ? "Без категории"
                                    : product.Category)
                            </td>

                            <td class="admin-product-price">
                                @product.Price.ToString("N2") ₽
                            </td>

                            <td>
                                @if (product.StockQuantity == 0)
                                {
                                    <span class="admin-stock empty">
                                        Нет в наличии
                                    </span>
                                }
                                else if (product.StockQuantity < 3)
                                {
                                    <span class="admin-stock low">
                                        @product.StockQuantity шт. · Мало
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-stock">
                                        @product.StockQuantity шт.
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="admin-product-actions">

                                    <a asp-controller="AdminProducts"
                                       asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="button button-light">
                                        Изменить
                                    </a>

                                    <form asp-controller="AdminProducts"
                                          asp-action="Delete"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          onsubmit="return confirm('Удалить товар «@product.Name»?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="button button-danger">
                                            Удалить
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

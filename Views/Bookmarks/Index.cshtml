@using MiniShop.Models
@model List<Product>

@{
    ViewData["Title"] = "Мои закладки";
}

<style>
    .bookmarks-page,
    .bookmarks-page * {
        box-sizing: border-box;
        font-family: inherit;
    }

    .bookmarks-page {
        padding: 35px 0 70px;
        color: #26332D;
    }

    .bookmarks-hero {
        margin-bottom: 30px;
        padding: 34px;
        border: 1px solid #E5EAE5;
        border-radius: 18px;
        background: #F5F6F2;
    }

    .bookmarks-eyebrow {
        margin: 0 0 12px;
        color: #78827B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    .bookmarks-hero h1 {
        margin: 0 0 12px;
        color: #263C35;
        font-size: clamp(30px, 4vw, 40px);
        letter-spacing: -1px;
    }

    .bookmarks-description {
        margin: 0;
        color: #78827B;
        line-height: 1.6;
    }

    .bookmarks-message {
        margin: 0 0 22px;
        padding: 14px 18px;
        border: 1px solid #DCE8DF;
        border-radius: 11px;
        background: #F5F8F4;
        color: #42604D;
        line-height: 1.5;
    }

    .bookmarks-empty {
        padding: 55px 25px;
        border: 1px solid #E5EAE5;
        border-radius: 17px;
        background: #FFFFFF;
        text-align: center;
    }

    .bookmarks-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        margin: 0 auto 18px;
        border-radius: 19px;
        background: #DCE8DF;
        font-size: 27px;
    }

    .bookmarks-empty h2 {
        margin: 0 0 12px;
        color: #263C35;
        font-size: 23px;
    }

    .bookmarks-empty p {
        margin: 0 0 23px;
        color: #78827B;
        line-height: 1.6;
    }

    .bookmarks-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 22px;
    }

    .bookmark-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #E5EAE5;
        border-radius: 16px;
        background: #FFFFFF;
        box-shadow: 0 5px 18px rgba(38, 60, 53, .035);
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

    .bookmark-card:hover {
        transform: translateY(-3px);
        border-color: #CFDED3;
        box-shadow: 0 10px 25px rgba(38, 60, 53, .08);
    }

    .bookmark-image {
        display: block;
        height: 220px;
        overflow: hidden;
        background: #F5F6F2;
    }

    .bookmark-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .3s;
    }

    .bookmark-card:hover .bookmark-image img {
        transform: scale(1.035);
    }

    .bookmark-info {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 19px;
    }

    .bookmark-info h3 {
        margin: 0 0 12px;
        color: #263C35;
        font-size: 17px;
        line-height: 1.4;
    }

    .bookmark-price {
        margin: 0 0 16px;
        color: #263C35;
        font-size: 21px;
        font-weight: 750;
    }

    .bookmark-details {
        display: inline-block;
        margin-bottom: 17px;
        color: #52735E;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
    }

    .bookmark-details:hover {
        color: #263C35;
        text-decoration: underline;
    }

    .bookmark-remove-form {
        margin-top: auto;
    }

    .bookmark-remove-form button {
        width: 100%;
        min-height: 42px;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        cursor: pointer;
    }

    @@media (max-width: 600px) {
        .bookmarks-page {
            padding: 22px 0 50px;
        }

        .bookmarks-hero {
            padding: 24px 20px;
        }

        .bookmarks-grid {
            grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
            gap: 13px;
        }

        .bookmark-image {
            height: 165px;
        }

        .bookmark-info {
            padding: 14px;
        }

        .bookmark-info h3 {
            font-size: 15px;
        }

        .bookmark-price {
            font-size: 18px;
        }

        .bookmarks-empty {
            padding: 40px 18px;
        }
    }
</style>

<div class="bookmarks-page">

    <section class="bookmarks-hero">
        <p class="bookmarks-eyebrow">
            SIMPLESTORE / ИЗБРАННОЕ
        </p>

        <h1>Мои закладки</h1>

        <p class="bookmarks-description">
            Здесь собраны товары, которые вы сохранили,
            чтобы вернуться к ним позже.
        </p>
    </section>

    @if (TempData["BookmarkMessage"] != null)
    {
        <div class="bookmarks-message">
            @TempData["BookmarkMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="bookmarks-empty">

            <div class="bookmarks-empty-icon">♡</div>

            <h2>Пока ничего не сохранено</h2>

            <p>
                Добавляйте понравившиеся товары в закладки,
                и они появятся на этой странице.
            </p>

            <a class="button button-dark"
               asp-controller="Products"
               asp-action="Index">
                Перейти в каталог
            </a>

        </div>
    }
    else
    {
        <div class="bookmarks-grid">

            @foreach (var product in Model)
            {
                <article class="bookmark-card">

                    <a class="bookmark-image"
                       asp-controller="Products"
                       asp-action="Details"
                       asp-route-id="@product.Id">

                        <img src="@product.ImageUrl"
                             alt="@product.Name" />
                    </a>

                    <div class="bookmark-info">

                        <h3>@product.Name</h3>

                        <p class="bookmark-price">
                            @product.DiscountedPrice.ToString("N0") ₽
                        </p>

                        <a class="bookmark-details"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id">
                            Подробнее о товаре →
                        </a>

                        <form class="bookmark-remove-form"
                              asp-controller="Bookmarks"
                              asp-action="Toggle"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@product.Id" />

                            <button class="button button-light"
                                    type="submit">
                                Удалить из закладок
                            </button>

                        </form>

                    </div>
                </article>
            }

        </div>
    }

</div>

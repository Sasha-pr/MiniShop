@model List<CartItem>

@{
    ViewData["Title"] = "Корзина";
    var total = Model.Sum(x => x.Total);
}

<style>
    .shop-cart,
    .shop-cart * {
        box-sizing: border-box;
        font-family: inherit;
    }

    .shop-cart {
        max-width: 1100px;
        margin: 0 auto;
        padding: 38px 16px 80px;
        color: #26332D;
        -webkit-font-smoothing: antialiased;
    }

    .cart-heading {
        margin-bottom: 30px;
    }

    .cart-heading .eyebrow {
        color: #78827B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    .cart-heading h1 {
        margin: 10px 0;
        color: #263C35;
        font-size: clamp(30px, 4vw, 40px);
        letter-spacing: -1.2px;
    }

    .cart-subtitle,
    .checkout-description {
        color: #78827B;
        line-height: 1.7;
        margin: 0;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 25px;
        align-items: start;
    }

    .cart-items-card,
    .cart-summary,
    .checkout-card,
    .cart-empty {
        background: #FFFFFF;
        border: 1px solid #E5EAE5;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(38, 60, 53, .045);
    }

    .cart-items-card {
        padding: 8px 25px;
    }

    .cart-product {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid #E5EAE5;
}

.cart-product:last-child {
    border-bottom: none;
}

.cart-product img {
    display: block;
    width: 80px;
    height: 80px;
    min-width: 0;
    object-fit: cover;
    border-radius: 12px;
    background: #F5F6F2;
}

.cart-product-info {
    min-width: 0;
}

.cart-product-info h3 {
    margin: 0 0 8px;
    color: #263C35;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
}

.cart-product-info p {
    margin: 0;
    color: #78827B;
    font-size: 12px;
    line-height: 1.5;
}

.cart-product-price {
    color: #263C35;
    font-size: 16px;
    font-weight: 750;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
}

.cart-product form {
    margin: 0;
}

.cart-remove {
    padding: 8px 5px;
    border: 0;
    background: transparent;
    color: #A16A64;
    font-family: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
}

.cart-remove:hover {
    color: #A12C2C;
}

    .cart-remove {
        padding: 9px;
        border: 0;
        background: transparent;
        color: #A16A64;
        font: inherit;
        font-size: 13px;
        cursor: pointer;
        transition: color .2s;
    }

    .cart-remove:hover {
        color: #A12C2C;
    }

    .cart-summary {
        position: sticky;
        top: 25px;
        padding: 25px;
    }

    .cart-summary h2 {
        margin: 0 0 22px;
        color: #263C35;
        font-size: 19px;
    }

    .cart-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 15px;
        color: #78827B;
        font-size: 14px;
    }

    .cart-summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #E5EAE5;
    }

    .cart-summary-total span {
        font-size: 15px;
        font-weight: 600;
    }

    .cart-summary-total strong {
        color: #263C35;
        font-size: 25px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .cart-summary-note,
    .checkout-note {
        margin: 16px 0 0;
        color: #78827B;
        font-size: 12px;
        line-height: 1.6;
    }

    .cart-clear {
        margin-top: 18px;
    }

    .cart-clear button {
        width: 100%;
    }

    .checkout-card {
        margin-top: 28px;
        padding: 30px;
    }

    .checkout-heading {
        margin-bottom: 27px;
    }

    .checkout-heading .eyebrow {
        color: #78827B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.3px;
    }

    .checkout-heading h2 {
        margin: 8px 0 10px;
        color: #263C35;
        font-size: 24px;
        letter-spacing: -.5px;
    }

    .checkout-description {
        font-size: 14px;
    }

    .checkout-form {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .checkout-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .checkout-field {
        display: flex;
        flex-direction: column;
        gap: 9px;
        min-width: 0;
    }

    .checkout-field label {
        color: #26332D;
        font-size: 13px;
        font-weight: 650;
        line-height: 1.4;
    }

    .checkout-field input,
    .checkout-field textarea,
    .checkout-field select {
        display: block;
        width: 100%;
        min-height: 49px;
        padding: 13px 15px;
        box-sizing: border-box;
        border: 1px solid #E5EAE5;
        border-radius: 10px;
        background: #F5F6F2;
        color: #26332D;
        font-family: inherit;
        font-size: 14px;
        line-height: 1.5;
        transition: border-color .2s, box-shadow .2s;
    }

    .checkout-field textarea {
        min-height: 105px;
        resize: vertical;
    }

    .checkout-field input:focus,
    .checkout-field textarea:focus,
    .checkout-field select:focus {
        outline: none;
        border-color: #789384;
        box-shadow: 0 0 0 3px rgba(120, 147, 132, .13);
    }

    .checkout-field input::placeholder,
    .checkout-field textarea::placeholder {
        color: #9AA39C;
    }

    .checkout-hint {
        color: #78827B;
        font-size: 12px;
        line-height: 1.5;
    }

    .checkout-bottom {
        display: flex;
        flex-direction: column;
        gap: 18px;
        padding-top: 22px;
        border-top: 1px solid #E5EAE5;
    }

    .checkout-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        border-radius: 12px;
        background: #DCE8DF;
    }

    .checkout-total span {
        color: #263C35;
        font-size: 14px;
        font-weight: 600;
    }

    .checkout-total strong {
        color: #263C35;
        font-size: 23px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .checkout-submit {
        width: 100%;
        min-height: 52px;
        border-radius: 10px;
        font-size: 15px;
        cursor: pointer;
    }

    .checkout-note {
        margin: 0;
        text-align: center;
    }

    .checkout-alert {
        margin-bottom: 22px;
        padding: 15px 18px;
        border-radius: 11px;
        font-size: 14px;
        line-height: 1.5;
    }

    .checkout-alert.success {
        border: 1px solid #D4E6D8;
        background: #EDF6EF;
        color: #32643B;
    }

    .checkout-alert.error {
        border: 1px solid #F0D5D2;
        background: #FFF3F1;
        color: #A9433C;
    }

    .cart-empty {
        padding: 55px 25px;
        text-align: center;
    }

    .cart-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 65px;
        height: 65px;
        margin: 0 auto 20px;
        border-radius: 20px;
        background: #DCE8DF;
        font-size: 28px;
    }

    .cart-empty h2 {
        margin: 0 0 10px;
        color: #263C35;
        font-size: 23px;
    }

    .cart-empty p {
        margin: 0 0 23px;
        color: #78827B;
        line-height: 1.6;
    }

    .checkout-login {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 22px;
    }

    @@media (max-width: 850px) {
        .cart-layout {
            grid-template-columns: 1fr;
        }

        .cart-summary {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .shop-cart {
            padding: 22px 12px 55px;
        }

        .cart-items-card {
            padding: 5px 15px;
        }

        .cart-product {
    grid-template-columns: 65px minmax(0, 1fr);
    gap: 12px;
}

.cart-product img {
    width: 65px;
    height: 65px;
}

.cart-product-info {
    min-width: 0;
}

.cart-product-price {
    grid-column: 2;
    margin: 0;
    font-size: 15px;
}

.cart-product form {
    grid-column: 2;
    justify-self: start;
}

.cart-remove {
    padding: 5px 0;
}

        .cart-summary {
            padding: 21px;
        }

        .checkout-card {
            padding: 23px 17px;
        }

        .checkout-row {
            grid-template-columns: 1fr;
        }

        .checkout-login {
            flex-direction: column;
        }

        .checkout-login a {
            width: 100%;
            box-sizing: border-box;
            text-align: center;
        }

        .cart-empty {
            padding: 40px 18px;
        }
    }
</style>

<div class="shop-cart">

    <div class="cart-heading">
        <p class="eyebrow">SIMPLESTORE / ПОКУПКИ</p>
        <h1>Корзина</h1>
        <p class="cart-subtitle">
            Проверьте выбранные товары и перейдите к оформлению заказа.
        </p>
    </div>

    @if (TempData["CheckoutSuccess"] != null)
    {
        <div class="checkout-alert success" role="status">
            @TempData["CheckoutSuccess"]
        </div>
    }

    @if (TempData["CheckoutError"] != null)
    {
        <div class="checkout-alert error" role="alert">
            @TempData["CheckoutError"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="cart-empty">
            <div class="cart-empty-icon">🛍</div>
            <h2>В корзине пока пусто</h2>
            <p>
                Самое время найти что-нибудь интересное
                в нашем каталоге.
            </p>

            <a class="button button-dark"
               asp-controller="Products"
               asp-action="Index">
                Перейти в каталог
            </a>
        </div>
    }
    else
    {
        <div class="cart-layout">

            <section class="cart-items-card"
                     aria-label="Товары в корзине">

                @foreach (var item in Model)
                {
                    <article class="cart-product">

                        <img src="@item.ImageUrl"
                             alt="@item.Name" />

                        <div class="cart-product-info">
                            <h3>@item.Name</h3>

                            <p>
                                @item.Price.ToString("N0") ₽
                                × @item.Quantity шт.
                            </p>
                        </div>

                        <strong class="cart-product-price">
                            @item.Total.ToString("N0") ₽
                        </strong>

                        <form asp-controller="Cart"
                              asp-action="Remove"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.ProductId" />

                            <button class="cart-remove"
                                    type="submit"
                                    aria-label="Удалить @item.Name из корзины">
                                Удалить
                            </button>
                        </form>

                    </article>
                }

            </section>

            <aside class="cart-summary">
                <h2>Ваш заказ</h2>

                <div class="cart-summary-row">
                    <span>Товары в корзине</span>
                    <span>@Model.Sum(x => x.Quantity) шт.</span>
                </div>

                <div class="cart-summary-total">
                    <span>Итого</span>
                    <strong>@total.ToString("N0") ₽</strong>
                </div>

                <p class="cart-summary-note">
                    Итоговая сумма заказа указана без онлайн-оплаты.
                    Оплата производится при получении.
                </p>

                <form asp-controller="Cart"
                      asp-action="Clear"
                      method="post"
                      class="cart-clear">

                    @Html.AntiForgeryToken()

                    <button class="button button-light"
                            type="submit">
                        Очистить корзину
                    </button>
                </form>
            </aside>

        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <section class="checkout-card">

                <div class="checkout-heading">
                    <p class="eyebrow">SIMPLESTORE / ОФОРМЛЕНИЕ</p>
                    <h2>Оформление заказа</h2>

                    <p class="checkout-description">
                        Заполните контактные данные и адрес доставки.
                        Поля со звёздочкой обязательны.
                    </p>
                </div>

                <form asp-controller="Cart"
                      asp-action="Checkout"
                      method="post"
                      class="checkout-form">

                    @Html.AntiForgeryToken()

                    <div class="checkout-row">

                        <div class="checkout-field">
                            <label for="CustomerName">ФИО *</label>

                            <input id="CustomerName"
                                   name="CustomerName"
                                   type="text"
                                   placeholder="Иванов Иван Иванович"
                                   autocomplete="name"
                                   maxlength="150"
                                   required />
                        </div>

                        <div class="checkout-field">
                            <label for="Phone">Телефон *</label>

                            <input id="Phone"
                                   name="Phone"
                                   type="tel"
                                   placeholder="+7 999 123-45-67"
                                   autocomplete="tel"
                                   maxlength="30"
                                   required />
                        </div>

                    </div>

                    <div class="checkout-field">
                        <label for="Address">Адрес доставки *</label>

                        <textarea id="Address"
                                  name="Address"
                                  placeholder="Город, улица, дом, квартира"
                                  autocomplete="street-address"
                                  maxlength="300"
                                  required></textarea>

                        <span class="checkout-hint">
                            Укажите полный адрес, по которому нужно доставить заказ.
                        </span>
                    </div>

                    <div class="checkout-field">
                        <label for="PaymentMethod">Способ оплаты *</label>

                        <select id="PaymentMethod"
                                name="PaymentMethod"
                                required>

                            <option value="">Выберите способ оплаты</option>

                            <option value="При получении">
                                Наличными при получении
                            </option>

                            <option value="Картой при получении">
                                Картой при получении
                            </option>
                        </select>
                    </div>

                    <div class="checkout-field">
                        <label for="Comment">Комментарий к заказу</label>

                        <textarea id="Comment"
                                  name="Comment"
                                  maxlength="1000"
                                  placeholder="Например, пожелания по доставке"></textarea>

                        <span class="checkout-hint">
                            Необязательное поле.
                        </span>
                    </div>

                    <div class="checkout-bottom">

                        <div class="checkout-total">
                            <span>Сумма заказа</span>
                            <strong>@total.ToString("N0") ₽</strong>
                        </div>

                        <button class="button button-dark checkout-submit"
                                type="submit">
                            Подтвердить заказ
                        </button>

                        <p class="checkout-note">
                            После подтверждения заказ появится в разделе «Мои заказы».
                            Оплата на сайте не производится.
                        </p>

                    </div>
                </form>
            </section>
        }
        else
        {
            <section class="checkout-card">

                <div class="checkout-heading">
                    <p class="eyebrow">SIMPLESTORE / АККАУНТ</p>
                    <h2>Готовы оформить заказ?</h2>

                    <p class="checkout-description">
                        Войдите в аккаунт или зарегистрируйтесь.
                        Товары останутся в корзине.
                    </p>
                </div>

                <div class="checkout-login">

                    <a class="button button-dark"
                       asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="/Cart">
                        Войти
                    </a>

                    <a class="button button-light"
                       asp-controller="Account"
                       asp-action="Register"
                       asp-route-returnUrl="/Cart">
                        Зарегистрироваться
                    </a>

                </div>
            </section>
        }
    }

</div>

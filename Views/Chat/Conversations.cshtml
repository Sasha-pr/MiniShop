@using MiniShop.Models
@using MiniShop.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@model List<ChatConversationViewModel>

@{
    ViewData["Title"] = "Обращения покупателей";

    var lastMessageIds = await Db.ChatMessages
        .GroupBy(m => m.UserId)
        .Select(g => g.Max(m => m.Id))
        .ToListAsync();

    var pendingUserIds = await Db.ChatMessages
        .Where(m =>
            lastMessageIds.Contains(m.Id) &&
            !m.IsStaff)
        .Select(m => m.UserId)
        .ToListAsync();

    var pendingCount = pendingUserIds.Count;
}

<style>
    .conversations-page,
    .conversations-page * {
        box-sizing: border-box;
        font-family: inherit;
    }

    .conversations-page {
        max-width: 950px;
        margin: 0 auto;
        padding: 38px 16px 70px;
        color: #26332D;
    }

    .conversations-eyebrow {
        margin: 0 0 12px;
        color: #78827B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    .conversations-page h1 {
        margin: 0 0 13px;
        color: #263C35;
        font-size: clamp(30px, 4vw, 38px);
        letter-spacing: -1px;
    }

    .conversations-description {
        margin: 0 0 27px;
        color: #78827B;
        line-height: 1.7;
    }

    .conversations-summary {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding: 20px 23px;
        border: 1px solid #DCE8DF;
        border-radius: 14px;
        background: #F5F8F4;
    }

    .conversations-summary strong {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 45px;
        height: 45px;
        padding: 0 10px;
        border-radius: 12px;
        background: #DCE8DF;
        color: #263C35;
        font-size: 22px;
        font-variant-numeric: tabular-nums;
    }

    .conversations-summary span {
        color: #52665A;
        font-size: 14px;
        line-height: 1.5;
    }

    .conversation-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 13px;
        padding: 22px 24px;
        border: 1px solid #E5EAE5;
        border-radius: 15px;
        background: #FFFFFF;
        box-shadow: 0 5px 18px rgba(38, 60, 53, .035);
        transition: border-color .2s, box-shadow .2s;
    }

    .conversation-card:hover {
        border-color: #CFDED3;
        box-shadow: 0 8px 22px rgba(38, 60, 53, .06);
    }

    .conversation-card.pending {
        border-left: 4px solid #789384;
        background: #FBFCFA;
    }

    .conversation-main {
        min-width: 0;
    }

    .conversation-name {
        margin-bottom: 10px;
        color: #263C35;
        font-size: 17px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .conversation-info {
        margin-top: 6px;
        color: #78827B;
        font-size: 13px;
        line-height: 1.5;
    }

    .conversation-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 13px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #F0F2EF;
        color: #78827B;
        font-size: 12px;
        font-weight: 600;
    }

    .conversation-status.pending {
        background: #E8F0E9;
        color: #42634D;
    }

    .conversation-open {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 11px 17px;
        border: 1px solid #263C35;
        border-radius: 9px;
        background: #263C35;
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s, border-color .2s;
    }

    .conversation-open:hover {
        border-color: #3D5A4D;
        background: #3D5A4D;
        color: #FFFFFF;
    }

    .conversation-empty {
        padding: 55px 25px;
        border: 1px solid #E5EAE5;
        border-radius: 16px;
        background: #FFFFFF;
        color: #78827B;
        text-align: center;
        line-height: 1.6;
    }

    @@media (max-width: 650px) {
        .conversations-page {
            padding: 24px 12px 50px;
        }

        .conversation-card {
            align-items: stretch;
            flex-direction: column;
            gap: 17px;
            padding: 19px;
        }

        .conversation-open {
            width: 100%;
        }

        .conversations-summary {
            padding: 16px;
        }
    }
</style>

<div class="conversations-page">

    <p class="conversations-eyebrow">
        SIMPLESTORE / ПОДДЕРЖКА
    </p>

    <h1>Обращения покупателей</h1>

    <p class="conversations-description">
        Просматривайте сообщения покупателей
        и отвечайте на новые обращения.
    </p>

    <div class="conversations-summary">
        <strong id="pending-summary">@pendingCount</strong>
        <span>переписок ожидают ответа</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="conversation-empty">
            Обращений пока нет.
        </div>
    }
    else
    {
        @foreach (var conversation in Model)
        {
            var isPending = pendingUserIds.Contains(
                conversation.UserId);

            <div class="conversation-card @(isPending ? "pending" : "")">

                <div class="conversation-main">

                    <div class="conversation-name">
                        @conversation.UserName
                    </div>

                    <div class="conversation-info">
                        Сообщений: @conversation.MessageCount
                    </div>

                    <div class="conversation-info">
                        Последняя активность:
                        @conversation.LastMessage.ToLocalTime()
                            .ToString("dd.MM.yyyy HH:mm")
                    </div>

                    @if (isPending)
                    {
                        <span class="conversation-status pending">
                            ● Ожидает ответа
                        </span>
                    }
                    else
                    {
                        <span class="conversation-status">
                            ✓ Ответ отправлен
                        </span>
                    }

                </div>

                <a class="conversation-open"
                   asp-controller="Chat"
                   asp-action="Conversation"
                   asp-route-userId="@conversation.UserId">
                    Открыть переписку →
                </a>

            </div>
        }
    }

</div>

<script>
    let previousPendingCount = @pendingCount;

    async function refreshPendingConversations() {
        if (document.hidden) return;

        try {
            const response = await fetch('/Chat/PendingCount');

            if (!response.ok) return;

            const data = await response.json();

            if (data.count !== previousPendingCount) {
                window.location.reload();
            }
        }
        catch (error) {
            console.error(
                'Ошибка обновления обращений',
                error
            );
        }
    }

    setInterval(refreshPendingConversations, 5000);
</script>

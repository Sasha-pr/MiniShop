@model List<MiniShop.Models.ChatMessage>

@{
    ViewData["Title"] = "Переписка с поддержкой";
    var supportRequest = ViewBag.SupportRequest as MiniShop.Models.SupportRequest;
}

<div class="request-chat-page">

    @if (supportRequest == null)
    {
        <section class="request-chat-not-found">
            <h2>Обращение не найдено</h2>
            <p>Возможно, оно было удалено или у вас нет доступа к нему.</p>

            <a asp-action="MyRequests"
               class="request-chat-button request-chat-secondary">
                Назад к обращениям
            </a>
        </section>
    }
    else
    {
        <section class="request-chat-hero">
            <div>
                <span class="request-chat-eyebrow">СЛУЖБА ПОДДЕРЖКИ SIMPLESTORE</span>
                <h1>Обращение №@supportRequest.Id</h1>
                <p>
                    Создано:
                    @supportRequest.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </p>
            </div>

            <div class="request-chat-status">
                <span>Статус обращения</span>
                <strong>@supportRequest.Status</strong>
            </div>
        </section>

        <section class="request-chat-card">
            <div class="request-chat-heading">
                <div>
                    <h2>История переписки</h2>
                    <p>Здесь отображаются ваши сообщения и ответы сотрудников.</p>
                </div>

                <a asp-action="MyRequests" class="request-chat-back">
                    ← Все обращения
                </a>
            </div>

            <div id="messages" class="request-chat-messages">
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var message in Model)
                    {
                        <div class="request-chat-message @(message.IsStaff ? "staff-message" : "user-message")"
                             data-message-id="@message.Id">

                            <strong class="request-chat-sender">
                                @(message.IsStaff ? "Поддержка" : "Вы")
                            </strong>

                            <p>@message.Text</p>

                            <small>
                                @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div id="empty-messages" class="request-chat-empty">
                        Пока сообщений нет. Напишите первое сообщение.
                    </div>
                }
            </div>

            @if (TempData["ChatError"] != null)
            {
                <div class="request-chat-error">
                    @TempData["ChatError"]
                </div>
            }

            <form asp-controller="Chat"
                  asp-action="SendRequest"
                  method="post"
                  class="request-chat-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="requestId"
                       value="@supportRequest.Id" />

                <label for="text">Ваше сообщение</label>

                <textarea id="text"
                          name="text"
                          rows="4"
                          minlength="3"
                          maxlength="2000"
                          required
                          placeholder="Напишите сообщение..."></textarea>

                <div class="request-chat-form-bottom">
                    <span>От 3 до 2000 символов</span>

                    <button type="submit"
                            class="request-chat-button request-chat-primary">
                        Отправить сообщение
                        <span>→</span>
                    </button>
                </div>
            </form>
        </section>
    }
</div>

@if (supportRequest != null)
{
    <script>
        let lastMessageId = @((Model != null && Model.Count > 0) ? Model.Max(m => m.Id) : 0);
        const requestId = @supportRequest.Id;
        const messagesContainer = document.getElementById("messages");

        let isLoading = false;

        async function loadNewMessages() {
            if (isLoading || !messagesContainer) {
                return;
            }

            isLoading = true;

            try {
                const response = await fetch(
                    `/Chat/RequestMessages?requestId=${requestId}&afterId=${lastMessageId}`
                );

                if (!response.ok) {
                    console.error("Ошибка загрузки сообщений:", response.status);
                    return;
                }

                const messages = await response.json();

                messages.forEach(message => {
                    if (message.id <= lastMessageId) {
                        return;
                    }

                    const emptyMessage = document.getElementById("empty-messages");

                    if (emptyMessage) {
                        emptyMessage.remove();
                    }

                    const bubble = document.createElement("div");

                    bubble.className = "request-chat-message " +
                        (message.isStaff ? "staff-message" : "user-message");

                    bubble.dataset.messageId = message.id;

                    const sender = document.createElement("strong");
                    sender.className = "request-chat-sender";
                    sender.textContent = message.isStaff ? "Поддержка" : "Вы";

                    const text = document.createElement("p");
                    text.textContent = message.text;

                    const date = document.createElement("small");
                    date.textContent = new Date(message.createdAt).toLocaleString();

                    bubble.append(sender, text, date);
                    messagesContainer.appendChild(bubble);

                    lastMessageId = message.id;
                });

                if (messages.length > 0) {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }
            }
            catch (error) {
                console.error("Не удалось загрузить сообщения:", error);
            }
            finally {
                isLoading = false;
            }
        }

        loadNewMessages();
        setInterval(loadNewMessages, 3000);
    </script>
}

<style>
    .request-chat-page {
        --chat-primary: #263C35;
        --chat-accent: #DCE8DF;
        --chat-bg: #F5F6F2;
        --chat-text: #26332D;
        --chat-muted: #78827B;
        --chat-border: #E5EAE5;

        max-width: 1000px;
        margin: 0 auto;
        padding: 28px 16px 60px;
        color: var(--chat-text);
        font-family: 'Inter', sans-serif;
    }

    .request-chat-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 28px;
        margin-bottom: 22px;
        background: var(--chat-bg);
        border: 1px solid var(--chat-border);
        border-radius: 20px;
    }

    .request-chat-eyebrow {
        display: inline-block;
        margin-bottom: 10px;
        color: var(--chat-muted);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .request-chat-hero h1 {
        margin: 0 0 9px;
        font-size: clamp(25px, 4vw, 34px);
        font-weight: 800;
        letter-spacing: -.7px;
    }

    .request-chat-hero p {
        margin: 0;
        color: var(--chat-muted);
        font-size: 13px;
    }

    .request-chat-status {
        display: flex;
        flex-direction: column;
        gap: 7px;
        flex-shrink: 0;
        padding: 14px 17px;
        background: #fff;
        border: 1px solid var(--chat-border);
        border-radius: 13px;
    }

    .request-chat-status span {
        color: var(--chat-muted);
        font-size: 11px;
    }

    .request-chat-status strong {
        color: var(--chat-primary);
        font-size: 14px;
    }

    .request-chat-card {
        padding: 27px;
        background: #fff;
        border: 1px solid var(--chat-border);
        border-radius: 20px;
    }

    .request-chat-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--chat-border);
    }

    .request-chat-heading h2 {
        margin: 0 0 6px;
        font-size: 20px;
        font-weight: 800;
    }

    .request-chat-heading p {
        margin: 0;
        color: var(--chat-muted);
        font-size: 12px;
        line-height: 1.5;
    }

    .request-chat-back {
        color: var(--chat-primary);
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .request-chat-back:hover {
        text-decoration: underline;
    }

    .request-chat-messages {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-height: 520px;
        min-height: 180px;
        overflow-y: auto;
        padding: 22px 4px;
        scroll-behavior: smooth;
    }

    .request-chat-message {
        width: fit-content;
        max-width: 78%;
        padding: 13px 16px;
        border: 1px solid var(--chat-border);
        border-radius: 15px;
        overflow-wrap: anywhere;
        box-sizing: border-box;
    }

    .staff-message {
        align-self: flex-start;
        background: var(--chat-bg);
        border-bottom-left-radius: 5px;
    }

    .user-message {
        align-self: flex-end;
        background: var(--chat-accent);
        border-color: #D2E0D5;
        border-bottom-right-radius: 5px;
    }

    .request-chat-sender {
        display: block;
        margin-bottom: 7px;
        color: var(--chat-primary);
        font-size: 12px;
        font-weight: 800;
    }

    .request-chat-message p {
        margin: 0 0 9px;
        color: var(--chat-text);
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .request-chat-message small {
        display: block;
        color: var(--chat-muted);
        font-size: 10px;
        text-align: right;
    }

    .request-chat-empty {
        padding: 35px 15px;
        color: var(--chat-muted);
        font-size: 13px;
        text-align: center;
    }

    .request-chat-error {
        margin: 10px 0;
        padding: 12px 14px;
        color: #963C3C;
        background: #FBECEC;
        border: 1px solid #F2D5D5;
        border-radius: 10px;
        font-size: 13px;
    }

    .request-chat-form {
        padding-top: 21px;
        border-top: 1px solid var(--chat-border);
    }

    .request-chat-form label {
        display: block;
        margin-bottom: 9px;
        font-size: 13px;
        font-weight: 750;
    }

    .request-chat-form textarea {
        display: block;
        width: 100%;
        min-height: 110px;
        padding: 14px 15px;
        color: var(--chat-text);
        background: #FAFBF9;
        border: 1px solid var(--chat-border);
        border-radius: 12px;
        outline: none;
        resize: vertical;
        box-sizing: border-box;
        font: inherit;
        font-size: 13px;
        line-height: 1.6;
        transition: .2s ease;
    }

    .request-chat-form textarea:focus {
        border-color: #8FA99A;
        box-shadow: 0 0 0 3px rgba(143, 169, 154, .16);
    }

    .request-chat-form textarea::placeholder {
        color: #A0AAA3;
    }

    .request-chat-form-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 13px;
    }

    .request-chat-form-bottom > span {
        color: var(--chat-muted);
        font-size: 11px;
    }

    .request-chat-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 43px;
        padding: 11px 17px;
        border: 1px solid transparent;
        border-radius: 11px;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

    .request-chat-primary {
        color: #fff;
        background: var(--chat-primary);
    }

    .request-chat-primary:hover {
        color: #fff;
        background: #38564A;
        transform: translateY(-1px);
    }

    .request-chat-secondary {
        color: var(--chat-primary);
        background: #fff;
        border-color: var(--chat-border);
    }

    .request-chat-secondary:hover {
        color: var(--chat-primary);
        background: var(--chat-bg);
    }

    .request-chat-not-found {
        padding: 45px 25px;
        background: #fff;
        border: 1px solid var(--chat-border);
        border-radius: 18px;
        text-align: center;
    }

    .request-chat-not-found h2 {
        margin: 0 0 10px;
    }

    .request-chat-not-found p {
        margin: 0 0 20px;
        color: var(--chat-muted);
    }

    @@media (max-width: 650px) {
        .request-chat-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 22px;
        }

        .request-chat-card {
            padding: 20px 15px;
        }

        .request-chat-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .request-chat-message {
            max-width: 90%;
        }

        .request-chat-form-bottom {
            align-items: stretch;
            flex-direction: column;
        }

        .request-chat-form-bottom .request-chat-button {
            width: 100%;
        }
    }
</style>

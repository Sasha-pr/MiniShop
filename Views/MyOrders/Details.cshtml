@using MiniShop.Models
@model Order

@{
    ViewData["Title"] = $"Заказ №{Model.Id}";

    bool canRequestReturn =
        Model.Status == "Завершён" &&
        Model.CompletedAt != null &&
        DateTime.UtcNow <= Model.CompletedAt.Value.AddDays(14);

    var statusClass = Model.Status switch
    {
        "Новый" => "status-new",
        "В обработке" => "status-process",
        "Отправлен" => "status-sent",
        "Завершён" => "status-completed",
        "Отменён" => "status-cancelled",
        _ => "status-new"
    };
}

<style>
    .order-details-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 25px 0 75px;
    }

    .order-details-heading {
        margin: 22px 0 30px;
    }

    .order-details-heading h1 {
        font-size: clamp(30px, 4vw, 40px);
        letter-spacing: -1px;
        margin: 10px 0;
    }

    .order-date {
        color: #85877f;
        font-size: 14px;
    }

    .order-details-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 22px;
        align-items: start;
    }

    .order-info-card,
    .order-summary-card,
    .order-item-card,
    .return-message {
        background: #fff;
        border: 1px solid #e8eae3;
        border-radius: 17px;
        box-shadow: 0 7px 24px rgba(32, 33, 31, .035);
    }

    .order-info-card {
        padding: 25px;
    }

    .order-info-card h2,
    .order-summary-card h2 {
        font-size: 19px;
        margin: 0 0 22px;
    }

    .order-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 23px;
    }

    .order-status::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-new {
        background: #f0f2ec;
        color: #68785b;
    }

    .status-process {
        background: #fff5e5;
        color: #9a6c2d;
    }

    .status-sent {
        background: #edf3fb;
        color: #4e719d;
    }

    .status-completed {
        background: #edf6ed;
        color: #397448;
    }

    .status-cancelled {
        background: #fff0ef;
        color: #a6534b;
    }

    .order-info-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
    }

    .order-info-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eceee8;
        font-size: 14px;
    }

    .order-info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .order-info-label {
        color: #85877f;
        flex-shrink: 0;
    }

    .order-info-value {
        color: #30312e;
        font-weight: 600;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .order-summary-card {
        padding: 24px;
        position: sticky;
        top: 25px;
    }

    .order-summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 18px;
        border-top: 1px solid #eceee8;
    }

    .order-summary-total span {
        font-size: 14px;
        font-weight: 600;
    }

    .order-summary-total strong {
        font-size: 25px;
        white-space: nowrap;
    }

    .order-summary-note {
        color: #85877f;
        font-size: 12px;
        line-height: 1.6;
        margin: 15px 0 0;
    }

    .order-section-heading {
        font-size: 23px;
        margin: 35px 0 18px;
        letter-spacing: -.5px;
    }

    .order-items-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .order-item-card {
        padding: 23px 25px;
    }

    .order-item-top {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        align-items: flex-start;
        margin-bottom: 13px;
    }

    .order-item-card h3 {
        font-size: 17px;
        margin: 0;
    }

    .order-item-price {
        font-weight: 700;
        white-space: nowrap;
    }

    .order-item-calculation {
        color: #85877f;
        font-size: 13px;
        margin: 0;
    }

    /* Обращение по товару */

    .product-support-action {
        margin-top: 18px;
    }

    /* Сворачиваемая форма возврата */

    .return-collapse {
        margin-top: 23px;
        border-top: 1px solid #eceee8;
        padding-top: 20px;
    }

    .return-collapse summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        list-style: none;
        color: #26332d;
        font-size: 15px;
        font-weight: 650;
        padding: 13px 16px;
        background: #f5f6f2;
        border: 1px solid #e5eae3;
        border-radius: 12px;
        transition: background .2s, border-color .2s;
    }

    .return-collapse summary::-webkit-details-marker {
        display: none;
    }

    .return-collapse summary::after {
        content: "+";
        font-size: 22px;
        font-weight: 400;
        color: #788b72;
    }

    .return-collapse[open] summary::after {
        content: "−";
    }

    .return-collapse summary:hover {
        background: #edf1e9;
        border-color: #cbd6c5;
    }

    .return-collapse-content {
        padding-top: 20px;
    }

    .return-form-heading {
        margin-bottom: 17px;
    }

    .return-form h4 {
        font-size: 16px;
        margin: 0 0 7px;
        color: #26332d;
    }

    .return-form-description {
        color: #85877f;
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }

    .return-form label {
        display: block;
        margin-bottom: 9px;
        color: #30312e;
        font-size: 13px;
        font-weight: 650;
    }

    .return-form textarea {
        display: block;
        width: 100%;
        box-sizing: border-box;
        min-height: 125px;
        padding: 14px 15px;
        border: 1px solid #dfe4dc;
        border-radius: 12px;
        background: #fafbf8;
        color: #26332d;
        font: inherit;
        font-size: 14px;
        line-height: 1.6;
        resize: vertical;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

    .return-form textarea::placeholder {
        color: #a0a69e;
    }

    .return-form textarea:focus {
        outline: none;
        background: #fff;
        border-color: #8b9a77;
        box-shadow: 0 0 0 3px rgba(139, 154, 119, .13);
    }

    .return-form-hint {
        display: block;
        margin: 8px 0 15px;
        color: #85877f;
        font-size: 12px;
        line-height: 1.5;
    }

    .return-form button {
        cursor: pointer;
    }

    .return-message {
        padding: 15px 18px;
        margin-bottom: 16px;
        font-size: 14px;
        line-height: 1.5;
    }

    .return-message.success {
        background: #edf6ed;
        border-color: #d9ead9;
        color: #32643b;
    }

    .return-message.error {
        background: #fff0f0;
        border-color: #f1dada;
        color: #a12c2c;
    }

    .return-info {
        margin-top: 25px;
        padding: 19px 21px;
        background: #f5f6f2;
        border-radius: 13px;
        color: #777b72;
        font-size: 13px;
        line-height: 1.7;
    }

    .order-bottom-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    @@media (max-width: 800px) {
        .order-details-grid {
            grid-template-columns: 1fr;
        }

        .order-summary-card {
            position: static;
        }
    }

    @@media (max-width: 600px) {
        .order-details-page {
            padding: 18px 0 55px;
        }

        .order-info-card,
        .order-summary-card,
        .order-item-card {
            padding: 19px 16px;
        }

        .order-info-row {
            flex-direction: column;
            gap: 5px;
        }

        .order-info-value {
            text-align: left;
        }

        .order-item-top {
            flex-direction: column;
        }

        .order-bottom-actions {
            flex-direction: column;
        }

        .order-bottom-actions a {
            width: 100%;
            text-align: center;
            box-sizing: border-box;
        }

        .return-form button {
            width: 100%;
        }
    }
</style>

<div class="order-details-page">

    <a class="back-link"
       asp-controller="MyOrders"
       asp-action="Index">
        ← Мои заказы
    </a>

    <div class="order-details-heading">
        <p class="eyebrow">SIMPLESTORE / МОИ ЗАКАЗЫ</p>
        <h1>Заказ №@Model.Id</h1>

        <p class="order-date">
            Оформлен:
            @(Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
        </p>
    </div>

    @if (TempData["ReturnError"] != null)
    {
        <div class="return-message error" role="alert">
            @TempData["ReturnError"]
        </div>
    }

    @if (TempData["ReturnSuccess"] != null)
    {
        <div class="return-message success" role="status">
            @TempData["ReturnSuccess"]
        </div>
    }

    <div class="order-details-grid">

        <section class="order-info-card">

            <h2>Информация о заказе</h2>

            <span class="order-status @statusClass">
                @Model.Status
            </span>

            <div class="order-info-list">

                <div class="order-info-row">
                    <span class="order-info-label">Получатель</span>
                    <span class="order-info-value">@Model.CustomerName</span>
                </div>

                <div class="order-info-row">
                    <span class="order-info-label">Телефон</span>
                    <span class="order-info-value">@Model.Phone</span>
                </div>

                <div class="order-info-row">
                    <span class="order-info-label">Адрес доставки</span>
                    <span class="order-info-value">@Model.Address</span>
                </div>

                <div class="order-info-row">
                    <span class="order-info-label">Способ оплаты</span>
                    <span class="order-info-value">@Model.PaymentMethod</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <div class="order-info-row">
                        <span class="order-info-label">Комментарий</span>
                        <span class="order-info-value">@Model.Comment</span>
                    </div>
                }

                @if (Model.CompletedAt != null)
                {
                    <div class="order-info-row">
                        <span class="order-info-label">Дата завершения</span>
                        <span class="order-info-value">
                            @(Model.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                        </span>
                    </div>
                }

            </div>
        </section>

        <aside class="order-summary-card">
            <h2>Итого по заказу</h2>

            <div class="order-summary-total">
                <span>Общая сумма</span>
                <strong>@Model.Total.ToString("N0") ₽</strong>
            </div>

            <p class="order-summary-note">
                Подробная информация о составе заказа указана ниже.
            </p>
        </aside>

    </div>

    <h2 class="order-section-heading">Товары в заказе</h2>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="order-items-list">

            @foreach (var item in Model.Items)
            {
                <article class="order-item-card">

                    <div class="order-item-top">
                        <h3>@item.ProductName</h3>

                        <strong class="order-item-price">
                            @((item.Price * item.Quantity).ToString("N0")) ₽
                        </strong>
                    </div>

                    <p class="order-item-calculation">
                        @item.Price.ToString("N0") ₽ × @item.Quantity шт.
                    </p>

                    @if (Model.Status == "Завершён" && Model.CompletedAt != null)
                    {
                        <div class="product-support-action">
                            <a asp-controller="ProductSupport"
                               asp-action="Create"
                               asp-route-orderItemId="@item.Id"
                               class="button button-light">
                                Обратиться по товару
                            </a>
                        </div>
                    }

                    @if (canRequestReturn)
                    {
                        <details class="return-collapse">

                            <summary>
                                Оформить возврат
                            </summary>

                            <div class="return-collapse-content">

                                <form asp-controller="ReturnRequests"
                                      asp-action="Create"
                                      method="post"
                                      class="return-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="orderItemId"
                                           value="@item.Id" />

                                    <div class="return-form-heading">
                                        <h4>Заявка на возврат</h4>

                                        <p class="return-form-description">
                                            Если товар вам не подошёл или возникла проблема,
                                            вы можете отправить заявку на возврат.
                                        </p>
                                    </div>

                                    <label for="reason-@item.Id">
                                        Причина возврата
                                    </label>

                                    <textarea id="reason-@item.Id"
                                              name="reason"
                                              rows="4"
                                              maxlength="1000"
                                              minlength="5"
                                              required
                                              placeholder="Например: товар пришёл с повреждением, не соответствует описанию или имеет неисправность."></textarea>

                                    <small class="return-form-hint">
                                        Опишите причину подробнее. Минимум 5, максимум 1000 символов.
                                    </small>

                                    <button type="submit"
                                            class="button button-dark">
                                        Отправить заявку на возврат
                                    </button>

                                </form>

                            </div>
                        </details>
                    }

                </article>
            }

        </div>
    }

    @if (Model.Status == "Завершён" && !canRequestReturn)
    {
        <div class="return-info">
            Срок подачи заявки на возврат по правилам этого проекта истёк.
        </div>
    }
    else if (Model.Status != "Завершён")
    {
        <div class="return-info">
            Подать заявку на возврат можно после завершения заказа.
            После завершения будет доступно 14 дней для отправки заявки.
        </div>
    }

    <div class="order-bottom-actions">

        <a class="button button-light"
           asp-controller="ReturnRequests"
           asp-action="Index">
            Мои заявки на возврат
        </a>

        <a class="button button-light"
           asp-controller="MyOrders"
           asp-action="Index">
            К списку заказов
        </a>

        <a class="button button-light"
           asp-controller="ProductSupport"
           asp-action="MyRequests">
            Мои обращения по товарам
        </a>
    </div>

</div>

@using MiniShop.Models
@model List<UserNotification>

@{
    ViewData["Title"] = "Мои уведомления";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<style>
    .notifications-page,
    .notifications-page * {
        box-sizing: border-box;
        font-family: inherit;
    }

    .notifications-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 38px 16px 75px;
        color: #26332D;
        -webkit-font-smoothing: antialiased;
    }

    .notifications-page .eyebrow {
        margin-bottom: 12px;
        color: #78827B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    .notifications-page h1 {
        margin: 0 0 13px;
        color: #263C35;
        font-size: clamp(30px, 4vw, 38px);
        letter-spacing: -1px;
    }

    .notifications-description {
        max-width: 650px;
        margin: 0 0 30px;
        color: #78827B;
        line-height: 1.7;
    }

    .notifications-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 22px;
        padding: 17px 20px;
        border: 1px solid #E5EAE5;
        border-radius: 13px;
        background: #FFFFFF;
    }

    .notifications-count {
        color: #78827B;
        font-size: 14px;
    }

    .notifications-count strong {
        color: #263C35;
        font-size: 16px;
    }

    .notifications-toolbar form,
    .notification-actions form {
        margin: 0;
    }

    .notifications-toolbar .button,
    .notification-actions .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 10px 16px;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
    }

    .notification-card {
        margin-bottom: 14px;
        padding: 22px 24px;
        border: 1px solid #E5EAE5;
        border-radius: 15px;
        background: #FFFFFF;
        box-shadow: 0 5px 18px rgba(38, 60, 53, .035);
        transition: border-color .2s, box-shadow .2s;
    }

    .notification-card:hover {
        border-color: #CFDED3;
        box-shadow: 0 8px 22px rgba(38, 60, 53, .06);
    }

    .notification-card.unread {
        border-left: 4px solid #789384;
        background: #FBFCFA;
    }

    .notification-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
    }

    .notification-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #52735E;
        font-size: 12px;
        font-weight: 700;
    }

    .notification-status.read {
        color: #929B94;
        font-weight: 500;
    }

    .notification-date {
        color: #929B94;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }

    .notification-message {
        margin: 0 0 19px;
        color: #26332D;
        font-size: 15px;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .notification-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
    }

    .notification-delete {
        min-height: 40px;
        padding: 9px 12px;
        border: 1px solid transparent;
        border-radius: 9px;
        background: transparent;
        color: #A16A64;
        font-family: inherit;
        font-size: 13px;
        cursor: pointer;
        transition: background .2s, color .2s;
    }

    .notification-delete:hover {
        background: #FFF3F1;
        color: #A12C2C;
    }

    .notifications-empty {
        padding: 55px 25px;
        border: 1px solid #E5EAE5;
        border-radius: 17px;
        background: #FFFFFF;
        text-align: center;
    }

    .notifications-empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        margin: 0 auto 18px;
        border-radius: 19px;
        background: #DCE8DF;
        font-size: 26px;
    }

    .notifications-empty h2 {
        margin: 0 0 12px;
        color: #263C35;
        font-size: 23px;
    }

    .notifications-empty p {
        max-width: 470px;
        margin: 0 auto 23px;
        color: #78827B;
        line-height: 1.7;
    }

    @@media (max-width: 600px) {
        .notifications-page {
            padding: 24px 12px 55px;
        }

        .notifications-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .notifications-toolbar form,
        .notifications-toolbar button {
            width: 100%;
        }

        .notification-card {
            padding: 18px 16px;
        }

        .notification-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .notification-actions form,
        .notification-actions a,
        .notification-actions button {
            width: 100%;
        }

        .notification-actions .button {
            width: 100%;
        }

        .notification-delete {
            text-align: center;
        }

        .notifications-empty {
            padding: 40px 18px;
        }
    }
</style>

<div class="notifications-page">

    <p class="eyebrow">
        SIMPLESTORE / МОЙ АККАУНТ
    </p>

    <h1>Мои уведомления</h1>

    <p class="notifications-description">
        Здесь собраны сообщения о поступлении товаров,
        изменении статуса заявок на возврат
        и других событиях в магазине.
    </p>

    <div class="notifications-toolbar">

        <span class="notifications-count">
            Непрочитанных: <strong>@unreadCount</strong>
        </span>

        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllAsRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="button button-light">
                    Прочитать все
                </button>
            </form>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="notifications-empty">

            <div class="notifications-empty-icon">🔔</div>

            <h2>Уведомлений пока нет</h2>

            <p>
                Когда появятся новости о товарах
                или ваших заявках, они будут отображаться здесь.
            </p>

            <a class="button button-dark"
               asp-controller="Products"
               asp-action="Index">
                Перейти в каталог
            </a>
        </div>
    }
    else
    {
        @foreach (var notification in Model)
        {
            var isReturnNotification =
                notification.ReturnRequestId.HasValue ||
                notification.Message.Contains(
                    "заявка",
                    StringComparison.OrdinalIgnoreCase
                );

            <article class="notification-card @(notification.IsRead ? "" : "unread")">

                <div class="notification-top">

                    @if (notification.IsRead)
                    {
                        <span class="notification-status read">
                            Прочитано
                        </span>
                    }
                    else
                    {
                        <span class="notification-status">
                            ● Новое уведомление
                        </span>
                    }

                    <span class="notification-date">
                        @(notification.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                    </span>
                </div>

                <p class="notification-message">
                    @notification.Message
                </p>

                <div class="notification-actions">

                    @if (notification.ReturnRequestId.HasValue)
                    {
                        <a class="button button-dark"
                           asp-controller="ReturnRequests"
                           asp-action="Details"
                           asp-route-id="@notification.ReturnRequestId.Value">
                            Открыть заявку
                        </a>
                    }
                    else if (isReturnNotification)
                    {
                        <a class="button button-dark"
                           asp-controller="ReturnRequests"
                           asp-action="Index">
                            Мои заявки на возврат
                        </a>
                    }
                    else if (notification.ProductId > 0)
                    {
                        <a class="button button-dark"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@notification.ProductId">
                            Посмотреть товар
                        </a>
                    }

                    @if (!notification.IsRead)
                    {
                        <form asp-controller="Notifications"
                              asp-action="MarkAsRead"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@notification.Id" />

                            <button type="submit"
                                    class="button button-light">
                                Отметить прочитанным
                            </button>
                        </form>
                    }

                    <form asp-controller="Notifications"
                          asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@notification.Id" />

                        <button type="submit"
                                class="notification-delete">
                            Удалить
                        </button>
                    </form>

                </div>
            </article>
        }
    }

</div>

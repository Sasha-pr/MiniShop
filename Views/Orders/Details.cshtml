@model MiniShop.Models.Order

@{
    ViewData["Title"] = $"Заказ №{Model.Id}";

    var statusClass = Model.Status switch
    {
        "Новый" => "new",
        "В обработке" => "processing",
        "Отправлен" => "sent",
        "Завершён" => "completed",
        "Отменён" => "cancelled",
        _ => ""
    };

    var items = Model.Items ?? new List<MiniShop.Models.OrderItem>();
    var statusHistory = ViewBag.StatusHistory
        as List<MiniShop.Models.OrderStatusHistory>
        ?? new List<MiniShop.Models.OrderStatusHistory>();
}

<style>
    .order-details-page,
    .order-details-page * {
        box-sizing: border-box;
        font-family: inherit;
    }

    .order-details-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 38px 16px 70px;
        color: #26332D;
    }

    .order-back {
        margin-bottom: 24px;
    }

    .order-back a {
        color: #526B5B;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .order-back a:hover {
        color: #263C35;
    }

    .order-details-heading {
        margin-bottom: 26px;
    }

    .order-details-heading .eyebrow {
        margin: 0 0 12px;
        color: #78827B;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.4px;
    }

    .order-details-heading h1 {
        margin: 0 0 10px;
        color: #263C35;
        font-size: clamp(30px, 4vw, 38px);
        letter-spacing: -1px;
    }

    .order-details-heading p {
        margin: 0 0 16px;
        color: #78827B;
        line-height: 1.6;
    }

    .order-details-card {
        margin-bottom: 18px;
        padding: 25px;
        border: 1px solid #E5EAE5;
        border-radius: 16px;
        background: #FFFFFF;
        box-shadow: 0 5px 18px rgba(38, 60, 53, .035);
    }

    .order-details-card h2 {
        margin: 0 0 20px;
        color: #263C35;
        font-size: 19px;
    }

    .order-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .order-details-field {
        min-width: 0;
        padding: 14px;
        border: 1px solid #EDF0EC;
        border-radius: 10px;
        background: #F7F8F5;
    }

    .order-details-label {
        display: block;
        margin-bottom: 7px;
        color: #929B94;
        font-size: 11px;
        font-weight: 600;
    }

    .order-details-value {
        color: #35453B;
        font-size: 13px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .order-details-status {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 8px;
        background: #F0F2EF;
        color: #68746B;
        font-size: 12px;
        font-weight: 700;
    }

    .order-details-status.new {
        background: #F7F0DF;
        color: #8A6B2E;
    }

    .order-details-status.processing {
        background: #EAF0F5;
        color: #4F6F8C;
    }

    .order-details-status.sent {
        background: #EFEDF7;
        color: #6D6192;
    }

    .order-details-status.completed {
        background: #E8F0E9;
        color: #42634D;
    }

    .order-details-status.cancelled {
        background: #FFF0EE;
        color: #A33B3B;
    }

    .order-customer-comment {
        margin-top: 15px;
        padding: 15px;
        border: 1px solid #E5EAE5;
        border-radius: 10px;
        background: #F7F8F5;
    }

    .order-customer-comment strong {
        color: #35453B;
        font-size: 13px;
    }

    .order-customer-comment p {
        margin: 8px 0 0;
        color: #68746B;
        font-size: 13px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .order-product {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 17px 0;
        border-bottom: 1px solid #EDF0EC;
    }

    .order-product:last-child {
        border-bottom: none;
    }

    .order-product h3 {
        margin: 0 0 7px;
        color: #35453B;
        font-size: 15px;
    }

    .order-product p {
        margin: 0;
        color: #929B94;
        font-size: 13px;
    }

    .order-product-price {
        color: #263C35;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .order-empty-text {
        margin: 0;
        color: #78827B;
        font-size: 13px;
    }

    .order-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding: 21px 24px;
        border: 1px solid #DCE8DF;
        border-radius: 13px;
        background: #EAF1EB;
        color: #35453B;
        font-size: 15px;
    }

    .order-total strong {
        color: #263C35;
        font-size: 24px;
        white-space: nowrap;
    }

    .order-status-form {
        display: grid;
        gap: 14px;
    }

    .order-status-form label {
        color: #526157;
        font-size: 13px;
        font-weight: 600;
    }

    .order-status-form select {
        width: 100%;
        min-height: 46px;
        padding: 11px 13px;
        border: 1px solid #DDE4DD;
        border-radius: 9px;
        background: #FFFFFF;
        color: #35453B;
        font: inherit;
        font-size: 14px;
    }

    .order-status-form select:focus {
        outline: none;
        border-color: #8FA997;
        box-shadow: 0 0 0 3px rgba(143, 169, 151, .15);
    }

    .order-status-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 11px;
    }

    .order-status-actions .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 16px;
        border-radius: 9px;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
    }

    .order-danger-zone {
        margin-top: 28px;
        padding: 22px;
        border: 1px solid #F0DEDC;
        border-radius: 15px;
        background: #FFFAF9;
    }

    .order-danger-zone h2 {
        margin: 0 0 9px;
        color: #873F3A;
        font-size: 17px;
    }

    .order-danger-zone p {
        margin: 0 0 17px;
        color: #927A77;
        font-size: 13px;
        line-height: 1.6;
    }

    .order-danger-zone button {
        min-height: 40px;
        padding: 9px 15px;
        border: 1px solid #E8CCCC;
        border-radius: 9px;
        background: #FFFFFF;
        color: #A33B3B;
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .order-danger-zone button:hover {
        background: #FFF0EE;
    }

    .order-message {
        margin-bottom: 14px;
        padding: 14px 17px;
        border: 1px solid #DCE8DF;
        border-radius: 10px;
        background: #EAF1EB;
        color: #42634D;
        font-size: 13px;
        line-height: 1.5;
    }

    .order-message.error {
        border-color: #F0DEDC;
        background: #FFF0EE;
        color: #A33B3B;
    }

    @@media (max-width: 600px) {
        .order-details-page {
            padding: 24px 12px 50px;
        }

        .order-details-card {
            padding: 18px;
        }

        .order-details-grid {
            grid-template-columns: 1fr;
        }

        .order-product {
            align-items: flex-start;
        }

        .order-total {
            padding: 17px;
        }

        .order-total strong {
            font-size: 20px;
        }

        .order-status-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .order-status-actions .button {
            width: 100%;
        }
    }
</style>

<div class="order-details-page">

    <div class="order-back">
        <a asp-controller="Orders"
           asp-action="Index">
            ← Все заказы
        </a>
    </div>

    <section class="order-details-heading">

        <p class="eyebrow">
            SIMPLESTORE / УПРАВЛЕНИЕ
        </p>

        <h1>Заказ №@Model.Id</h1>

        <p>Подробная информация о заказе покупателя.</p>

        <span class="order-details-status @statusClass">
            @Model.Status
        </span>

    </section>

    @if (TempData["OrderSuccess"] != null)
    {
        <div class="order-message">
            @TempData["OrderSuccess"]
        </div>
    }

    @if (TempData["OrderError"] != null)
    {
        <div class="order-message error">
            @TempData["OrderError"]
        </div>
    }

    <section class="order-details-card">

        <h2>Данные покупателя</h2>

        <div class="order-details-grid">

            <div class="order-details-field">
                <span class="order-details-label">ФИО</span>
                <div class="order-details-value">
                    @(Model.CustomerName ?? "Не указано")
                </div>
            </div>

            <div class="order-details-field">
                <span class="order-details-label">Email</span>
                <div class="order-details-value">
                    @(Model.CustomerEmail ?? "Не указан")
                </div>
            </div>

            <div class="order-details-field">
                <span class="order-details-label">Телефон</span>
                <div class="order-details-value">
                    @(Model.Phone ?? "Не указан")
                </div>
            </div>

            <div class="order-details-field">
                <span class="order-details-label">Способ оплаты</span>
                <div class="order-details-value">
                    @(Model.PaymentMethod ?? "Не указан")
                </div>
            </div>

            <div class="order-details-field">
                <span class="order-details-label">Адрес доставки</span>
                <div class="order-details-value">
                    @(Model.Address ?? "Не указан")
                </div>
            </div>

            <div class="order-details-field">
                <span class="order-details-label">Дата оформления</span>
                <div class="order-details-value">
                    @(Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                </div>
            </div>

            @if (Model.CompletedAt.HasValue)
            {
                <div class="order-details-field">
                    <span class="order-details-label">Дата завершения</span>
                    <div class="order-details-value">
                        @(Model.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                    </div>
                </div>
            }

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Comment))
        {
            <div class="order-customer-comment">
                <strong>Комментарий покупателя</strong>
                <p>@Model.Comment</p>
            </div>
        }

    </section>

    <section class="order-details-card">

        <h2>Товары в заказе</h2>

        @if (items.Count == 0)
        {
            <p class="order-empty-text">
                В заказе нет товаров.
            </p>
        }
        else
        {
            @foreach (var item in items)
            {
                <div class="order-product">

                    <div>
                        <h3>@item.ProductName</h3>

                        <p>
                            @item.Price.ToString("N0") ₽ × @item.Quantity
                        </p>
                    </div>

                    <div class="order-product-price">
                        @((item.Price * item.Quantity).ToString("N0")) ₽
                    </div>

                </div>
            }
        }

    </section>

    <div class="order-total">
        <span>Итого к оплате</span>
        <strong>@Model.Total.ToString("N0") ₽</strong>
    </div>

    <section class="order-details-card">

        <h2>Изменить статус заказа</h2>

        <form asp-action="UpdateStatus"
              method="post"
              class="order-status-form">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <label for="status">Выбери новый статус</label>

            <select id="status" name="status" required>

                <option value="Новый" selected="@(Model.Status == "Новый")">
                    Новый
                </option>

                <option value="В обработке" selected="@(Model.Status == "В обработке")">
                    В обработке
                </option>

                <option value="Отправлен" selected="@(Model.Status == "Отправлен")">
                    Отправлен
                </option>

                <option value="Завершён" selected="@(Model.Status == "Завершён")">
                    Завершён
                </option>

                <option value="Отменён" selected="@(Model.Status == "Отменён")">
                    Отменён
                </option>

            </select>

            <div class="order-status-actions">

                <button class="button button-dark" type="submit">
                    Сохранить статус
                </button>

                <a class="button button-light"
                   asp-controller="Orders"
                   asp-action="Index">
                    Назад к заказам
                </a>

            </div>

        </form>

    </section>

    <section class="order-details-card">

        <h2>История статусов</h2>

        @if (statusHistory.Count == 0)
        {
            <p class="order-empty-text">
                Изменений статуса пока нет.
            </p>
        }
        else
        {
            @foreach (var record in statusHistory)
            {
                <div class="order-product">

                    <div>
                        <h3>
                            @record.OldStatus → @record.NewStatus
                        </h3>

                        <p>
                            @(record.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                        </p>
                    </div>

                </div>
            }
        }

    </section>

    <section class="order-danger-zone">

        <h2>Удаление заказа</h2>

        <p>
            Удаление заказа — необратимое действие.
            Перед удалением убедись, что заказ действительно нужно удалить.
        </p>

        <form asp-action="Delete"
              method="post"
              onsubmit="return confirm('Удалить заказ №@Model.Id?');">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit">
                Удалить заказ
            </button>

        </form>

    </section>

</div>

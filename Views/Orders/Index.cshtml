@model List<MiniShop.Models.Order>

@{
    ViewData["Title"] = "Управление заказами";
}

<section class="page-heading">
    <p class="eyebrow">SIMPLESTORE / УПРАВЛЕНИЕ</p>
    <h1>Заказы</h1>
    <p class="muted">Просмотр заказов покупателей.</p>
</section>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>Заказов пока нет</h2>
        <p class="muted">Когда покупатели оформят заказы, они появятся здесь.</p>
    </div>
}
else
{
    <div class="cart-list">
        @foreach (var order in Model)
        {
            <article class="cart-item">
                <div class="cart-item-info">
                    <h3>Заказ №@order.Id</h3>
                    <p>@order.CustomerEmail</p>
                    <p class="muted">
                        @order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>
                    <p>Статус: @order.Status</p>
                    <p>Товаров: @order.Items.Sum(x => x.Quantity)</p>
                </div>

                <strong>@order.Total.ToString("N0") ₽</strong>

                <a class="text-link"
                   asp-action="Details"
                   asp-route-id="@order.Id">
                    Открыть →
                </a>
            </article>
        }
    </div>
}

@using MiniShop.Models
@model Product

@{
    ViewData["Title"] = Model.Name;

    var reviews = ViewBag.Reviews as List<ProductReview>
                  ?? new List<ProductReview>();

    bool loggedIn = User.Identity?.IsAuthenticated == true;
    bool isStaff = User.IsInRole("Moderator") || User.IsInRole("Admin");

    double averageRating = reviews.Count > 0
        ? reviews.Average(r => r.Rating)
        : 0;

    int totalReviews = reviews.Count;
}

<style>
    .shop-details {
        max-width: 1180px;
        margin: 0 auto;
        padding: 22px 0 70px;
        color: #26332D;
    }

    .shop-details * {
        box-sizing: border-box;
    }

    .shop-details .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 22px;
        color: #78827B;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .shop-details .back-link:hover {
        color: #263C35;
    }

    .shop-details .product-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
        gap: 45px;
        align-items: start;
        margin-bottom: 65px;
    }

    .shop-details .product-photo {
        position: sticky;
        top: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 470px;
        padding: 35px;
        overflow: hidden;
        border: 1px solid #E5EAE5;
        border-radius: 20px;
        background: #F5F6F2;
    }

    .shop-details .product-photo img {
        display: block;
        width: 100%;
        max-height: 430px;
        object-fit: contain;
    }

    .shop-details .product-info {
        padding: 10px 0;
    }

    .shop-details .eyebrow {
        margin: 0 0 10px;
        color: #788F7E;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 1.4px;
    }

    .shop-details .product-title {
        margin: 0 0 17px;
        color: #26332D;
        font-size: clamp(29px, 4vw, 41px);
        line-height: 1.15;
        font-weight: 750;
        letter-spacing: -1.3px;
        overflow-wrap: anywhere;
    }

    .shop-details .product-rating {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin: 15px 0 23px;
    }

    .shop-details .stars {
        color: #D5A744;
        font-size: 19px;
        letter-spacing: 2px;
        white-space: nowrap;
    }

    .shop-details .rating-number {
        color: #26332D;
        font-size: 14px;
        font-weight: 750;
    }

    .shop-details .rating-caption,
    .shop-details .muted {
        color: #78827B;
        font-size: 13px;
    }

    .shop-details .price-block {
        padding: 22px 0;
        border-top: 1px solid #E5EAE5;
        border-bottom: 1px solid #E5EAE5;
    }

    .shop-details .product-price {
        margin: 0;
        color: #263C35;
        font-size: 34px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .shop-details .old-price {
        margin-right: 10px;
        color: #9AA39C;
        font-size: 18px;
        font-weight: 400;
        text-decoration: line-through;
    }

    .shop-details .discount-label {
        display: inline-block;
        margin-top: 9px;
        padding: 6px 11px;
        border-radius: 7px;
        background: #F3EBDD;
        color: #93672D;
        font-size: 12px;
        font-weight: 700;
    }

    .shop-details .stock-message {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 20px 0;
        padding: 13px 15px;
        border: 1px solid #DCE8DF;
        border-radius: 10px;
        background: #F0F6F1;
        color: #476B53;
        font-size: 13px;
        font-weight: 600;
    }

    .shop-details .stock-message.warning {
        border-color: #F0E2C8;
        background: #FBF5EA;
        color: #956B32;
    }

    .shop-details .stock-message.empty {
        border-color: #F0DADA;
        background: #FBEEEE;
        color: #A65353;
    }

    .shop-details .product-description {
        margin: 24px 0;
        color: #626D65;
        font-size: 14px;
        line-height: 1.85;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .shop-details .product-actions {
        display: flex;
        flex-direction: column;
        gap: 11px;
        margin-top: 25px;
    }

    .shop-details .product-actions form {
        min-width: 0;
        margin: 0;
    }

    .shop-details .product-actions button,
    .shop-details .product-actions > a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 48px;
        padding: 12px 17px;
        border: 1px solid transparent;
        border-radius: 10px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

    .shop-details .button-dark {
        background: #263C35;
        color: #fff;
    }

    .shop-details .button-dark:hover {
        background: #365449;
        color: #fff;
    }

    .shop-details .button-light {
        border-color: #DCE5DD !important;
        background: #EAF0EB;
        color: #263C35;
    }

    .shop-details .button-light:hover {
        background: #DCE8DF;
        color: #263C35;
    }

    .shop-details .product-actions button:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    .shop-details .secondary-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        width: 100%;
        margin-top: 2px;
    }

    .shop-details .secondary-actions form {
        display: flex;
        min-width: 0;
        width: 100%;
        margin: 0;
    }

    .shop-details .secondary-actions button,
    .shop-details .secondary-actions a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        min-width: 0;
        min-height: 48px;
        padding: 11px 12px;
        border: 1px solid #DCE5DD;
        border-radius: 10px;
        background: #EAF0EB;
        color: #263C35;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        line-height: 1.4;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease;
    }

    .shop-details .secondary-actions button:hover,
    .shop-details .secondary-actions a:hover {
        border-color: #C5D6C9;
        background: #DCE8DF;
        color: #263C35;
    }

    .shop-details .secondary-actions button:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    .shop-details .product-notice {
        margin: 3px 0 0;
        padding: 12px 14px;
        border-radius: 9px;
        background: #F0F6F1;
        color: #476B53;
        font-size: 13px;
    }

    /* Отзывы */

    .shop-details .reviews {
        padding-top: 42px;
        border-top: 1px solid #E5EAE5;
    }

    .shop-details .reviews-heading {
        margin-bottom: 22px;
    }

    .shop-details .reviews-heading h2 {
        margin: 7px 0;
        color: #26332D;
        font-size: 29px;
        font-weight: 750;
        letter-spacing: -.8px;
    }

    .shop-details .reviews-toggle {
        overflow: hidden;
        border: 1px solid #E5EAE5;
        border-radius: 15px;
        background: #fff;
    }

    .shop-details .reviews-toggle summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 21px 24px;
        color: #26332D;
        cursor: pointer;
        list-style: none;
        font-size: 14px;
        font-weight: 750;
    }

    .shop-details .reviews-toggle summary::-webkit-details-marker {
        display: none;
    }

    .shop-details .reviews-toggle summary::after {
        content: "+";
        color: #587563;
        font-size: 25px;
        font-weight: 400;
        flex-shrink: 0;
    }

    .shop-details .reviews-toggle[open] summary::after {
        content: "−";
    }

    .shop-details .reviews-toggle summary:hover {
        background: #F8FAF7;
    }

    .shop-details .reviews-content {
        padding: 20px 24px 25px;
        border-top: 1px solid #E5EAE5;
    }

    .shop-details .reviews-content > .muted {
        margin: 0;
        line-height: 1.6;
    }

    .shop-details .reviews-list {
        display: grid;
        gap: 12px;
        margin: 0;
    }

    .shop-details .review-card {
        min-width: 0;
        padding: 17px 19px;
        border: 1px solid #E5EAE5;
        border-radius: 12px;
        background: #fff;
    }

    .shop-details .review-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 5px 12px;
        margin: 0 0 8px;
    }

    .shop-details .review-author {
        color: #26332D;
        font-size: 14px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .shop-details .review-date {
        color: #929B94;
        font-size: 12px;
        white-space: nowrap;
    }

    .shop-details .review-stars {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin: 0 0 9px;
        color: #D5A744;
        font-size: 16px;
        letter-spacing: 1px;
    }

    .shop-details .review-stars .rating-caption {
        color: #929B94;
        font-size: 11px;
        letter-spacing: 0;
    }

    .shop-details .review-text {
        margin: 0;
        padding: 0;
        color: #4F5C53;
        font-size: 14px;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .shop-details .staff-reply {
        margin: 12px 0 0;
        padding: 11px 14px;
        border-left: 3px solid #587563;
        border-radius: 0 8px 8px 0;
        background: #F1F5F1;
    }

    .shop-details .staff-reply strong {
        display: block;
        margin: 0 0 5px;
        color: #365449;
        font-size: 12px;
    }

    .shop-details .staff-reply p {
        margin: 0;
        padding: 0;
        color: #4F5C53;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .shop-details .review-form-card {
        margin-top: 20px;
        padding: 22px;
        border: 1px solid #E5EAE5;
        border-radius: 14px;
        background: #F8FAF7;
    }

    .shop-details .review-form-card h3 {
        margin: 0 0 8px;
        color: #26332D;
        font-size: 20px;
        font-weight: 750;
    }

    .shop-details .review-form {
        display: flex;
        flex-direction: column;
        gap: 13px;
        margin-top: 16px;
    }

    .shop-details .review-form label {
        color: #35443A;
        font-size: 13px;
        font-weight: 650;
    }

    .shop-details .review-form textarea {
    width: 100%;
    min-height: 65px;
    height: 65px;
    padding: 10px 12px;
    border: 1px solid #DCE5DD;
    border-radius: 9px;
    background: #fff;
    color: #26332D;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.4;
    resize: vertical;
}

    .shop-details .review-form textarea:focus {
        outline: 2px solid #8AA694;
        outline-offset: 1px;
    }

    .shop-details .review-form button {
        align-self: flex-start;
        min-height: 44px;
        padding: 11px 22px;
        border-radius: 9px;
    }

    .shop-details .review-rating-picker {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        margin: 4px 0 8px;
    }

    .shop-details .review-rating-title {
        color: #35443A;
        font-size: 14px;
        font-weight: 650;
    }

    .shop-details .review-rating-stars {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
    }

    .shop-details .review-rating-stars input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    .shop-details .review-rating-stars label {
        color: #D7DCD6;
        font-size: 35px;
        line-height: 1;
        cursor: pointer;
        transition: color .15s ease, transform .15s ease;
    }

    .shop-details .review-rating-stars label:hover {
        transform: scale(1.1);
    }

    .shop-details .review-rating-stars label:hover,
    .shop-details .review-rating-stars label:hover ~ label,
    .shop-details .review-rating-stars input:checked ~ label {
        color: #D5A744;
    }

    .shop-details .review-rating-stars input:focus-visible + label {
        outline: 2px solid #8AA694;
        outline-offset: 3px;
        border-radius: 3px;
    }

    .shop-details .review-rating-hint {
        color: #78827B;
        font-size: 12px;
    }

    .shop-details .review-error,
    .shop-details .review-success {
        margin-bottom: 17px;
        padding: 13px 15px;
        border-radius: 10px;
        font-size: 13px;
    }

    .shop-details .review-error {
        border: 1px solid #F0DADA;
        background: #FBEEEE;
        color: #A65353;
    }

    .shop-details .review-success {
        border: 1px solid #DCE8DF;
        background: #F0F6F1;
        color: #476B53;
    }

    .shop-details .staff-form {
        margin-top: 13px;
    }

    @@media (max-width: 750px) {
        .shop-details {
            padding: 15px 0 45px;
        }

        .shop-details .product-layout {
            grid-template-columns: 1fr;
            gap: 24px;
            margin-bottom: 45px;
        }

        .shop-details .product-photo {
            position: static;
            min-height: 300px;
            padding: 20px;
        }

        .shop-details .product-photo img {
            height: 280px;
        }

        .shop-details .product-title {
            font-size: 31px;
        }

        .shop-details .secondary-actions {
            grid-template-columns: 1fr;
        }

        .shop-details .review-card,
        .shop-details .review-form-card {
            padding: 16px;
        }

        .shop-details .reviews-toggle summary {
            padding: 18px;
        }

        .shop-details .reviews-content {
            padding: 15px 12px 19px;
        }
    }
</style>

<div class="shop-details">

    <a class="back-link"
       asp-controller="Products"
       asp-action="Index">
        ← Назад в каталог
    </a>

    <section class="product-layout">

        <div class="product-photo">
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        </div>

        <div class="product-info">
            <p class="eyebrow">SIMPLESTORE / ТОВАР</p>

            <h1 class="product-title">@Model.Name</h1>

            <div class="product-rating">
                @if (totalReviews > 0)
                {
                    <span class="stars" aria-label="Средняя оценка">
                        @{
                            int fullStars = (int)Math.Round(
                                averageRating,
                                MidpointRounding.AwayFromZero);
                        }

                        @for (int i = 1; i <= 5; i++)
                        {
                            @(i <= fullStars ? "★" : "☆")
                        }
                    </span>

                    <span class="rating-number">
                        @averageRating.ToString("0.0")
                    </span>

                    <span class="rating-caption">
                        (@totalReviews отзывов)
                    </span>
                }
                else
                {
                    <span class="stars">☆☆☆☆☆</span>
                    <span class="rating-caption">Пока нет оценок</span>
                }
            </div>

            <div class="price-block">
                @if (Model.HasLowStock && Model.StockQuantity > 0)
                {
                    <p class="product-price">
                        <span class="old-price">
                            @Model.Price.ToString("N0") ₽
                        </span>
                        @Model.DiscountedPrice.ToString("N0") ₽
                    </p>

                    <span class="discount-label">Скидка 30%</span>
                }
                else
                {
                    <p class="product-price">
                        @Model.Price.ToString("N0") ₽
                    </p>
                }
            </div>

            @if (Model.StockQuantity <= 0)
            {
                <div class="stock-message empty">
                    Нет в наличии
                </div>
            }
            else if (Model.HasLowStock)
            {
                <div class="stock-message warning">
                    Осталось всего @Model.StockQuantity шт.
                </div>
            }
            else
            {
                <div class="stock-message">
                    В наличии: @Model.StockQuantity шт.
                </div>
            }

            <p class="product-description">
                @Model.Description
            </p>

            <div class="product-actions">

                @if (Model.StockQuantity > 0)
                {
                    <button class="button-dark"
                            type="button"
                            data-add-to-cart="@Model.Id">
                        Добавить в корзину
                    </button>
                }
                else
                {
                    @if (loggedIn)
                    {
                        <form asp-controller="Waitlist"
                              asp-action="Subscribe"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.Id" />

                            <button class="button-dark"
                                    type="submit">
                                🔔 Сообщить о поступлении
                            </button>
                        </form>

                        <a class="button-light"
                           asp-controller="Waitlist"
                           asp-action="Index">
                            Мой лист ожидания
                        </a>
                    }
                    else
                    {
                        <a class="button-dark"
                           asp-controller="Account"
                           asp-action="Login">
                            Войти, чтобы ожидать товар
                        </a>
                    }
                }

                <div class="secondary-actions">

                    @if (loggedIn)
                    {
                        <form id="like-form"
                              asp-controller="Likes"
                              asp-action="Toggle"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.Id" />

                            <button class="button-light"
                                    type="submit"
                                    id="like-button">

                                <span id="like-icon">
                                    @(ViewBag.HasLiked == true ? "♥" : "♡")
                                </span>

                                Нравится

                                <span id="like-count">
                                    @ViewBag.LikeCount
                                </span>
                            </button>
                        </form>

                        <form asp-controller="Bookmarks"
                              asp-action="Toggle"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.Id" />

                            <button class="button-light"
                                    type="submit">
                                ♡ В закладки
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="button-light"
                           asp-controller="Account"
                           asp-action="Login">
                            ♡ Войти для лайков
                        </a>

                        <a class="button-light"
                           asp-controller="Account"
                           asp-action="Login">
                            ♡ Войти для закладок
                        </a>
                    }
                </div>

                @if (TempData["BookmarkMessage"] != null)
                {
                    <p class="product-notice" role="status">
                        @TempData["BookmarkMessage"]
                    </p>
                }

            </div>
        </div>
    </section>

    <section class="reviews">

        <div class="reviews-heading">
            <p class="eyebrow">МНЕНИЯ ПОКУПАТЕЛЕЙ</p>
            <h2>Отзывы о товаре</h2>
            <p class="muted">
                Читай впечатления покупателей и делись своим опытом.
            </p>
        </div>

        @if (TempData["ReviewError"] != null)
        {
            <div class="review-error" role="alert">
                @TempData["ReviewError"]
            </div>
        }

        @if (TempData["ReviewSuccess"] != null)
        {
            <div class="review-success" role="status">
                @TempData["ReviewSuccess"]
            </div>
        }

        <details class="reviews-toggle">
            <summary>
                <span>
                    Посмотреть отзывы (@totalReviews)

                    @if (totalReviews > 0)
                    {
                        <span class="rating-caption">
                            · Средняя оценка @averageRating.ToString("0.0") из 5
                        </span>
                    }
                </span>
            </summary>

            <div class="reviews-content">

                @if (reviews.Count == 0)
                {
                    <p class="muted">
                        У этого товара пока нет отзывов.
                        Стань первым покупателем, который поделится впечатлением!
                    </p>
                }
                else
                {
                    <div class="reviews-list">

                        @foreach (var review in reviews)
                        {
                            <article class="review-card">

                                <div class="review-header">
                                    <span class="review-author">
                                        @review.UserName
                                    </span>

                                    <span class="review-date">
                                        @(review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                    </span>
                                </div>

                                <div class="review-stars"
                                     aria-label="Оценка: @review.Rating из 5">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        @(i <= review.Rating ? "★" : "☆")
                                    }

                                    <span class="rating-caption">
                                        @review.Rating из 5
                                    </span>
                                </div>

                                <p class="review-text">@review.Text</p>

                                @if (!string.IsNullOrWhiteSpace(review.ModeratorReply))
                                {
                                    <div class="staff-reply">
                                        <strong>
                                            Ответ магазина — @review.ModeratorName
                                        </strong>

                                        <p>@review.ModeratorReply</p>
                                    </div>
                                }

                                @if (isStaff)
                                {
                                    <div class="staff-form">
                                        <form class="review-form"
                                              asp-controller="Reviews"
                                              asp-action="Reply"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="reviewId"
                                                   value="@review.Id" />

                                            <label for="reply-@review.Id">
                                                Ответить покупателю
                                            </label>

                                            <textarea id="reply-@review.Id"
                                                      name="reply"
                                                      maxlength="1000"
                                                      placeholder="Напишите ответ от имени магазина..."
                                                      required>@review.ModeratorReply</textarea>

                                            <button class="button-dark"
                                                    type="submit">
                                                Сохранить ответ
                                            </button>
                                        </form>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }

                @if (loggedIn)
                {
                    <div class="review-form-card">
                        <h3>Оставить отзыв</h3>

                        <p class="muted">
                            Оставить отзыв и оценку можно после получения товара.
                            На один товар разрешён один отзыв от пользователя.
                        </p>

                        <form class="review-form"
                              asp-controller="Reviews"
                              asp-action="Add"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.Id" />

                            <div class="review-rating-picker">
                                <span class="review-rating-title">Ваша оценка</span>

                                <div class="review-rating-stars"
                                     role="radiogroup"
                                     aria-label="Оценка товара">

                                    @for (int rating = 5; rating >= 1; rating--)
                                    {
                                        <input type="radio"
                                               id="rating-@rating"
                                               name="Rating"
                                               value="@rating"
                                               checked="@(rating == 5)"
                                               required />

                                        <label for="rating-@rating"
                                               title="@($"{rating} из 5")"
                                               aria-label="@($"{rating} из 5 звёзд")">
                                            ★
                                        </label>
                                    }
                                </div>

                                <span class="review-rating-hint">
                                    Выбери от 1 до 5 звёзд
                                </span>
                            </div>

                            <label for="review-text">
                                Ваш отзыв
                            </label>

                            <textarea id="review-text"
                                      name="text"
                                      minlength="3"
                                      maxlength="1000"
                                      placeholder="Что вам понравилось в товаре?"
                                      required></textarea>

                            <button class="button-dark"
                                    type="submit">
                                Опубликовать отзыв
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="review-form-card">
                        <h3>Хотите оставить отзыв?</h3>

                        <p class="muted">
                            Войдите в аккаунт, чтобы оставить отзыв после получения товара.
                        </p>

                        <a class="button-dark"
                           asp-controller="Account"
                           asp-action="Login">
                            Войти
                        </a>
                    </div>
                }

            </div>
        </details>
    </section>
</div>

<script>
    const likeForm = document.getElementById("like-form");

    if (likeForm) {
        likeForm.addEventListener("submit", async function (event) {
            event.preventDefault();

            const button = document.getElementById("like-button");
            const icon = document.getElementById("like-icon");
            const count = document.getElementById("like-count");

            if (!button || !icon || !count) {
                return;
            }

            button.disabled = true;

            try {
                const response = await fetch(likeForm.action, {
                    method: "POST",
                    body: new FormData(likeForm),
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!response.ok) {
                    alert("Не удалось изменить лайк. Попробуйте ещё раз.");
                    return;
                }

                const data = await response.json();

                if (data.success !== true) {
                    alert("Не удалось изменить лайк.");
                    return;
                }

                icon.textContent = data.liked ? "♥" : "♡";
                count.textContent = data.count;
            }
            catch (error) {
                alert("Ошибка соединения. Проверьте интернет и попробуйте ещё раз.");
            }
            finally {
                button.disabled = false;
            }
        });
    }
</script>
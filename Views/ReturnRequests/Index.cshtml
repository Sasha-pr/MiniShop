
@using MiniShop.Models
@model IEnumerable<ReturnRequest>

@{
    ViewData["Title"] = "Мои заявки на возврат";
}

<style>
    .returns-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 35px 0 80px;
    }

    .returns-page * {
        box-sizing: border-box;
    }

    .returns-heading {
        margin-bottom: 32px;
    }

    .returns-heading h1 {
        font-size: clamp(29px, 4vw, 40px);
        letter-spacing: -1.4px;
        margin: 12px 0;
        color: #20211f;
    }

    .returns-heading p.description {
        color: #777;
        line-height: 1.7;
        max-width: 650px;
        margin: 0;
    }

    .returns-alert {
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 18px;
        line-height: 1.5;
        background: #f1f5ed;
        border: 1px solid #dfe8d8;
        color: #526b43;
    }

    .returns-alert.error {
        background: #fff4f3;
        border-color: #f0d8d5;
        color: #a33b3b;
    }

    .returns-list {
        display: grid;
        gap: 18px;
    }

    .return-item {
        background: #fff;
        border: 1px solid #e9eae6;
        border-radius: 18px;
        padding: 25px;
        transition: border-color .2s, box-shadow .2s;
    }

    .return-item:hover {
        border-color: #cbd4c2;
        box-shadow: 0 8px 25px rgba(32, 33, 31, .045);
    }

    .return-item-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 22px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eeeeeb;
    }

    .return-item-number {
        font-size: 18px;
        font-weight: 750;
        color: #20211f;
    }

    .return-item-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        background: #f5f6f2;
        color: #777;
    }

    .return-item-status::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .return-item-status.approved {
        color: #587849;
        background: #eff5eb;
    }

    .return-item-status.rejected {
        color: #a33b3b;
        background: #fff0ef;
    }

    .return-item-status.pending {
        color: #a17b35;
        background: #fbf5e8;
    }

    .return-item-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
    }

    .return-item-field {
        padding: 16px;
        background: #f7f8f5;
        border: 1px solid #f0f1ed;
        border-radius: 12px;
        min-width: 0;
    }

    .return-item-label {
        display: block;
        color: #888;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .return-item-value {
        color: #20211f;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .return-item-actions {
        margin-top: 22px;
        display: flex;
        justify-content: flex-start;
    }

    .return-item-actions a {
        text-decoration: none;
    }

    .returns-empty {
        text-align: center;
        padding: 65px 25px;
        border: 1px solid #e9eae6;
        border-radius: 18px;
        background: #fff;
    }

    .returns-empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f1f4ed;
        color: #788b69;
        font-size: 27px;
    }

    .returns-empty h2 {
        font-size: 24px;
        margin: 0 0 12px;
        color: #20211f;
    }

    .returns-empty p {
        color: #777;
        line-height: 1.7;
        max-width: 420px;
        margin: 0 auto 24px;
    }

    @@media (max-width: 600px) {
        .returns-page {
            padding-top: 20px;
        }

        .return-item {
            padding: 18px;
        }

        .return-item-info {
            grid-template-columns: 1fr;
        }

        .return-item-actions a {
            width: 100%;
            text-align: center;
        }

        .returns-empty {
            padding: 45px 18px;
        }
    }
</style>

<div class="returns-page">

    <div class="returns-heading">
        <p class="eyebrow">SIMPLESTORE / ЛИЧНЫЙ КАБИНЕТ</p>

        <h1>Мои заявки на возврат</h1>

        <p class="description">
            Здесь отображаются все отправленные тобой заявки,
            их текущие статусы и ответы сотрудников магазина.
        </p>
    </div>

    @if (TempData["ReturnSuccess"] != null)
    {
        <div class="returns-alert">
            @TempData["ReturnSuccess"]
        </div>
    }

    @if (TempData["ReturnError"] != null)
    {
        <div class="returns-alert error">
            @TempData["ReturnError"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="returns-empty">
            <div class="returns-empty-icon">↩</div>

            <h2>Заявок пока нет</h2>

            <p>
                Когда ты отправишь заявку на возврат,
                она появится в этом разделе.
                Здесь можно будет следить за её рассмотрением.
            </p>

            <a class="button button-dark"
               asp-controller="MyOrders"
               asp-action="Index">
                Перейти к заказам
            </a>
        </div>
    }
    else
    {
        <div class="returns-list">

            @foreach (var request in Model)
            {
                var statusClass = request.Status switch
                {
                    "Одобрена" => "approved",
                    "Отклонена" => "rejected",
                    _ => "pending"
                };

                <article class="return-item">

                    <div class="return-item-top">

                        <div class="return-item-number">
                            Заявка @request.RequestNumber
                        </div>

                        <span class="return-item-status @statusClass">
                            @request.Status
                        </span>

                    </div>

                    <div class="return-item-info">

                        <div class="return-item-field">
                            <span class="return-item-label">
                                Дата создания
                            </span>

                            <div class="return-item-value">
                                @(request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                            </div>
                        </div>

                        <div class="return-item-field">
                            <span class="return-item-label">
                                Номер заказа
                            </span>

                            <div class="return-item-value">
                                №@request.OrderId
                            </div>
                        </div>

                        <div class="return-item-field">
                            <span class="return-item-label">
                                Товар
                            </span>

                            <div class="return-item-value">
                                @(request.OrderItem?.ProductName ?? "Информация недоступна")
                            </div>
                        </div>

                        @if (request.ReviewedAt.HasValue)
                        {
                            <div class="return-reviewed-date">
                                <span class="return-reviewed-label">Дата рассмотрения</span>
                                <strong>
                                    @request.ReviewedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </strong>
                            </div>
                        }

                    </div>

                    <div class="return-item-actions">
                        <a class="button button-dark"
                           asp-controller="ReturnRequests"
                           asp-action="Details"
                           asp-route-id="@request.Id">
                            Подробнее о заявке
                        </a>
                    </div>

                </article>
            }

        </div>
    }

</div>

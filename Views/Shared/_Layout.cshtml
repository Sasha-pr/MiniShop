<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SimpleStore</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="logo" asp-controller="Products" asp-action="Index">
            simple<span>store</span>
        </a>

        <nav>
            <a asp-controller="Products" asp-action="Index">Каталог</a>

            <a class="cart-link" asp-controller="Cart" asp-action="Index">
                Корзина <span id="cart-count" class="count">0</span>
            </a>

            @if (User.IsInRole("Moderator") || User.IsInRole("Admin"))
            {
                <a asp-controller="Orders" asp-action="Index">Заказы</a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index">Пользователи</a>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="MyOrders" asp-action="Index">Мои заказы</a>
                <span>@User.Identity.Name</span>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit">Выйти</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register">Регистрация</a>
                <a asp-controller="Account" asp-action="Login">Вход</a>
            }
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">SimpleStore · Учебный мини-магазин</footer>
    <div id="toast" class="toast" role="status"></div>
    <form id="csrf-form" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <script>
        async function updateCartCount() {
            try {
                const response = await fetch('/Cart/Count');
                if (!response.ok) return;

                const data = await response.json();
                document.getElementById('cart-count').textContent = data.count;
            } catch (error) {
                console.error('Не удалось обновить корзину', error);
            }
        }

        async function addToCart(productId) {
            try {
                const response = await fetch(
                    '/Cart/Add?id=' + encodeURIComponent(productId),
                    {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken':
                                document.querySelector(
                                    '#csrf-form input[name="__RequestVerificationToken"]'
                                ).value
                        }
                    }
                );

                const data = await response.json();

                if (!response.ok) {
                    showToast(data.message || 'Не удалось добавить товар.');
                    return;
                }

                document.getElementById('cart-count').textContent = data.count;
                showToast(data.message);
            } catch (error) {
                showToast('Ошибка соединения. Попробуйте ещё раз.');
            }
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('visible');

            clearTimeout(window.toastTimer);

            window.toastTimer = setTimeout(
                () => toast.classList.remove('visible'),
                2200
            );
        }

        document.addEventListener('DOMContentLoaded', () => {
            updateCartCount();

            document.querySelectorAll('[data-add-to-cart]').forEach(button => {
                button.addEventListener('click', () => {
                    addToCart(button.dataset.addToCart);
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
